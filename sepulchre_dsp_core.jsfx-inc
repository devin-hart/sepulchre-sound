// sepulchre_dsp_core.jsfx-inc
// Core biquad filters, parameter smoothing, Input/Gate and the GE-7 graphic EQ (before or after the pedal).
// Distortion (Mod 1) is in sepulchre_dsp_dist.jsfx-inc
@init

function alloc_buf(size) local(ptr) (
  ptr = mem_top; mem_top += size; ptr;
);

function db2lin(db) ( 10.0 ^ (db * 0.05); );
function clamp(v, lo, hi) ( max(lo, min(hi, v)); );

function soft_tanh(x) local(x2) (
  x = clamp(x, -3.0, 3.0); x2 = x * x;
  x * (27.0 + x2) / (27.0 + 9.0 * x2);
);

// Linear below -3.1 dBFS (0.70), C1 cubic knee to exact ceiling L (-1.0 dBFS = 0.89125). Round 30: knee raised from
// -6 dBFS so WAV IR mode (peaks about -7..-4 dBFS since the +3.8 dB ear-match) passes untouched.
function limit_sample(x, L) local(k, ax, t, d, s) (
  k = 0.7; ax = abs(x);
  ax <= k ? x : (
    d = L - k; t = (ax - k) / d;
    s = t >= 1.5 ? L : (k + d * (t - (4.0 / 27.0) * t * t * t));
    x >= 0.0 ? s : -s;
  );
);

// Biquad layout: [0]=b0, [1]=b1, [2]=b2, [3]=a1, [4]=a2, [5]=z1L, [6]=z2L, [7]=z1R, [8]=z2R
function bq_clear(b) ( b[5] = 0; b[6] = 0; b[7] = 0; b[8] = 0; );

function bq_lp_sr(b, freq, q, sr) local(w0, cosw, sinw, alpha, inv_a0) (
  freq = clamp(freq, 20.0, sr * 0.46);
  w0 = 2.0 * $pi * freq / sr;
  cosw = cos(w0); sinw = sin(w0);
  alpha = sinw / (2.0 * max(0.1, q));
  inv_a0 = 1.0 / (1.0 + alpha);
  b[1] = (1.0 - cosw) * inv_a0;
  b[0] = b[1] * 0.5; b[2] = b[0];
  b[3] = (-2.0 * cosw) * inv_a0;
  b[4] = (1.0 - alpha) * inv_a0;
);

function bq_lp(b, freq, q) ( bq_lp_sr(b, freq, q, srate); );

function bq_hp_sr(b, freq, q, sr) local(w0, cosw, sinw, alpha, inv_a0) (
  freq = clamp(freq, 20.0, sr * 0.46);
  w0 = 2.0 * $pi * freq / sr;
  cosw = cos(w0); sinw = sin(w0);
  alpha = sinw / (2.0 * max(0.1, q));
  inv_a0 = 1.0 / (1.0 + alpha);
  b[0] = (1.0 + cosw) * 0.5 * inv_a0;
  b[1] = -(1.0 + cosw) * inv_a0; b[2] = b[0];
  b[3] = (-2.0 * cosw) * inv_a0;
  b[4] = (1.0 - alpha) * inv_a0;
);

function bq_hp(b, freq, q) ( bq_hp_sr(b, freq, q, srate); );

function bq_peak_sr(b, freq, q, gain_db, sr) local(A, w0, cosw, sinw, alpha, inv_a0) (
  freq = clamp(freq, 20.0, sr * 0.46);
  A = 10.0 ^ (gain_db / 40.0);
  w0 = 2.0 * $pi * freq / sr;
  cosw = cos(w0); sinw = sin(w0);
  alpha = sinw / (2.0 * max(0.1, q));
  inv_a0 = 1.0 / (1.0 + alpha / A);
  b[0] = (1.0 + alpha * A) * inv_a0;
  b[1] = (-2.0 * cosw) * inv_a0;
  b[2] = (1.0 - alpha * A) * inv_a0;
  b[3] = b[1];
  b[4] = (1.0 - alpha / A) * inv_a0;
);

function bq_peak(b, freq, q, gain_db) ( bq_peak_sr(b, freq, q, gain_db, srate); );

function bq_lshelf(b, freq, gain_db) local(A, w0, cosw, sinw, alpha, sqA2a, inv_a0) (
  freq = clamp(freq, 20.0, srate * 0.46);
  A = 10.0 ^ (gain_db / 40.0);
  w0 = 2.0 * $pi * freq / srate;
  cosw = cos(w0); sinw = sin(w0);
  alpha = sinw * 0.5 * sqrt(2.0);
  sqA2a = 2.0 * sqrt(A) * alpha;
  inv_a0 = 1.0 / ((A + 1.0) + (A - 1.0) * cosw + sqA2a);
  b[0] = A * ((A + 1.0) - (A - 1.0) * cosw + sqA2a) * inv_a0;
  b[1] = 2.0 * A * ((A - 1.0) - (A + 1.0) * cosw) * inv_a0;
  b[2] = A * ((A + 1.0) - (A - 1.0) * cosw - sqA2a) * inv_a0;
  b[3] = -2.0 * ((A - 1.0) + (A + 1.0) * cosw) * inv_a0;
  b[4] = ((A + 1.0) + (A - 1.0) * cosw - sqA2a) * inv_a0;
);

function bq_hshelf(b, freq, gain_db) local(A, w0, cosw, sinw, alpha, sqA2a, inv_a0) (
  freq = clamp(freq, 20.0, srate * 0.46);
  A = 10.0 ^ (gain_db / 40.0);
  w0 = 2.0 * $pi * freq / srate;
  cosw = cos(w0); sinw = sin(w0);
  alpha = sinw * 0.5 * sqrt(2.0);
  sqA2a = 2.0 * sqrt(A) * alpha;
  inv_a0 = 1.0 / ((A + 1.0) - (A - 1.0) * cosw + sqA2a);
  b[0] = A * ((A + 1.0) + (A - 1.0) * cosw + sqA2a) * inv_a0;
  b[1] = -2.0 * A * ((A - 1.0) + (A + 1.0) * cosw) * inv_a0;
  b[2] = A * ((A + 1.0) + (A - 1.0) * cosw - sqA2a) * inv_a0;
  b[3] = 2.0 * ((A - 1.0) - (A + 1.0) * cosw) * inv_a0;
  b[4] = ((A + 1.0) - (A - 1.0) * cosw - sqA2a) * inv_a0;
);

function bq_proc_l(b, x) local(y) (
  y = b[0] * x + b[5]; b[5] = b[1] * x - b[3] * y + b[6]; b[6] = b[2] * x - b[4] * y; y;
);

function bq_proc_r(b, x) local(y) (
  y = b[0] * x + b[7]; b[7] = b[1] * x - b[3] * y + b[8]; b[8] = b[2] * x - b[4] * y; y;
);

// ---------- Module 4: Boss GE-7 style 7-band graphic EQ (Round 31) ----------
// Bands 100 / 200 / 400 / 800 / 1.6k / 3.2k / 6.4 kHz, +/-15 dB each, Level +/-15 dB. The pedal's gyrator band
// filters are reciprocal boost/cut with Q that rises with boost; an RBJ peak with fixed Q 1.0 does the same
// (pole Q 1.0 flat -> 2.4 at +15 dB). Round 42: fixed position, before or after the pedal (slider76).
function eq_clear() (
  bq_clear(bq_eq1); bq_clear(bq_eq2); bq_clear(bq_eq3); bq_clear(bq_eq4);
  bq_clear(bq_eq5); bq_clear(bq_eq6); bq_clear(bq_eq7);
);
function update_eq_coeffs() (
  bq_peak(bq_eq1, 100.0, 1.0, slider66);  bq_peak(bq_eq2, 200.0, 1.0, slider67);
  bq_peak(bq_eq3, 400.0, 1.0, slider68);  bq_peak(bq_eq4, 800.0, 1.0, slider69);
  bq_peak(bq_eq5, 1600.0, 1.0, slider70); bq_peak(bq_eq6, 3200.0, 1.0, slider71);
  bq_peak(bq_eq7, 6400.0, 1.0, slider72);
  eq_lvl_t = db2lin(slider73);
  eq_pos_last != slider76 ? ( eq_pos_last = slider76; eq_clear(); );   // Round 46: moved pre<->post: drop old state
);
// Bypass crossfades over ~20 ms (no click); filters idle and clear once fully bypassed
function proc_eq() local(l, r) (
  eq_mix_s = param_smooth_c * eq_mix_s + (1.0 - param_smooth_c) * (slider65 > 0.5 ? 1.0 : 0.0);
  eq_lvl_s = param_smooth_c * eq_lvl_s + (1.0 - param_smooth_c) * eq_lvl_t;
  eq_mix_s > 0.0001 ? (
    l = bq_proc_l(bq_eq4, bq_proc_l(bq_eq3, bq_proc_l(bq_eq2, bq_proc_l(bq_eq1, spl0))));
    r = bq_proc_r(bq_eq4, bq_proc_r(bq_eq3, bq_proc_r(bq_eq2, bq_proc_r(bq_eq1, spl1))));
    l = bq_proc_l(bq_eq7, bq_proc_l(bq_eq6, bq_proc_l(bq_eq5, l))) * eq_lvl_s;
    r = bq_proc_r(bq_eq7, bq_proc_r(bq_eq6, bq_proc_r(bq_eq5, r))) * eq_lvl_s;
    spl0 += eq_mix_s * (l - spl0); spl1 += eq_mix_s * (r - spl1);
  ) : ( eq_mix_s > 0 ? ( eq_mix_s = 0; eq_clear(); ); );
);

function init_core_dsp() (
  bq_in_hp = alloc_buf(9); bq_gate_det = alloc_buf(9);
  bq_dist_gyr1 = alloc_buf(9); bq_dist_gyr2 = alloc_buf(9); bq_dist_post = alloc_buf(9); bq_dist_tb = alloc_buf(9);
  bq_dist_p1 = alloc_buf(9); bq_dist_p2 = alloc_buf(9); bq_dist_p3 = alloc_buf(9);
  bq_dist_p4 = alloc_buf(9); bq_dist_p5 = alloc_buf(9); bq_dist_p6 = alloc_buf(9);
  // 8th-order (4-stage) steep oversampling filters for up and down conversion
  bq_os_up1 = alloc_buf(9); bq_os_up2 = alloc_buf(9); bq_os_up3 = alloc_buf(9); bq_os_up4 = alloc_buf(9);
  bq_os_dn1 = alloc_buf(9); bq_os_dn2 = alloc_buf(9); bq_os_dn3 = alloc_buf(9); bq_os_dn4 = alloc_buf(9);
  bq_eq1 = alloc_buf(9); bq_eq2 = alloc_buf(9); bq_eq3 = alloc_buf(9); bq_eq4 = alloc_buf(9);   // GE-7 bands
  bq_eq5 = alloc_buf(9); bq_eq6 = alloc_buf(9); bq_eq7 = alloc_buf(9);
  sl_snap = alloc_buf(80);
  eq_mix_s = 0.0; eq_lvl_s = 1.0;
  gate_env = 0.0; gate_gain = 0.0; gate_open = 0; gate_hold_cnt = 0;
  dc_x1_l = 0.0; dc_y1_l = 0.0; dc_x1_r = 0.0; dc_y1_r = 0.0;
  in_trim_s = 1.0; dist_mk_s = 0.0; master_out_s = 1.0;
  chorus_mix_s = 0.0; reverb_mix_s = 0.0;
  meter_in_peak = 0.0; meter_out_peak = 0.0;
);

function reset_core_state() (
  bq_clear(bq_in_hp); bq_clear(bq_gate_det);
  bq_clear(bq_dist_gyr1); bq_clear(bq_dist_gyr2); bq_clear(bq_dist_post);
  bq_clear(bq_os_up1); bq_clear(bq_os_up2); bq_clear(bq_os_up3); bq_clear(bq_os_up4);
  bq_clear(bq_os_dn1); bq_clear(bq_os_dn2); bq_clear(bq_os_dn3); bq_clear(bq_os_dn4);
  eq_clear();
  gate_env = 0.0; gate_gain = 0.0; gate_open = 0; gate_hold_cnt = 0;
  dc_x1_l = 0.0; dc_y1_l = 0.0; dc_x1_r = 0.0; dc_y1_r = 0.0;
  in_trim_s = in_trim_t; dist_mk_s = dist_mk_t; master_out_s = master_out_t; eq_lvl_s = eq_lvl_t;
);

function update_core_coeffs() (
  param_smooth_c = exp(-1.0 / (0.020 * srate));
  meter_decay_c = exp(-1.0 / (0.300 * srate));
  dc_r = exp(-2.0 * $pi * 10.0 / srate);

  in_trim_t = db2lin(slider1);
  bq_hp(bq_in_hp, slider2, 0.7071);
  bq_hp(bq_gate_det, 180.0, 0.7071);

  gate_thresh_open = db2lin(slider3);
  gate_thresh_close = db2lin(slider3 - 5.0);
  gate_hold_samples = floor(0.025 * srate);
  gate_att_coeff = exp(-1.0 / (0.0015 * srate));
  gate_rel_coeff = exp(-1.0 / (0.045 * srate));
  gate_open_gain_c = exp(-1.0 / (0.003 * srate));
  gate_rel_gain_c = exp(-1.0 / (0.035 * srate));

  // Pedal coefficients live in update_dist_coeffs() (sepulchre_dsp_dist.jsfx-inc)
);

function proc_input_gate() local(det_l, det_r, det, target_g) (
  in_trim_s = param_smooth_c * in_trim_s + (1.0 - param_smooth_c) * in_trim_t;
  spl0 *= in_trim_s; spl1 *= in_trim_s;
  meter_in_peak = max(meter_in_peak * meter_decay_c, max(abs(spl0), abs(spl1)));
  spl0 = bq_proc_l(bq_in_hp, spl0); spl1 = bq_proc_r(bq_in_hp, spl1);

  slider4 > 0.5 ? (
    det_l = bq_proc_l(bq_gate_det, spl0); det_r = bq_proc_r(bq_gate_det, spl1);
    det = max(abs(det_l), abs(det_r));
    det > gate_env ? (
      gate_env = gate_att_coeff * gate_env + (1.0 - gate_att_coeff) * det;
    ) : (
      gate_env = gate_rel_coeff * gate_env + (1.0 - gate_rel_coeff) * det;
    );
    gate_env >= gate_thresh_open ? (
      gate_open = 1; gate_hold_cnt = gate_hold_samples;
    ) : gate_open ? (
      gate_env < gate_thresh_close ? (
        gate_hold_cnt > 0 ? ( gate_hold_cnt -= 1; ) : ( gate_open = 0; );
      ) : ( gate_hold_cnt = gate_hold_samples; );
    );
    target_g = gate_open ? 1.0 : 0.0;
    target_g > gate_gain ? (
      gate_gain = gate_open_gain_c * gate_gain + (1.0 - gate_open_gain_c) * target_g;
    ) : (
      gate_gain = gate_rel_gain_c * gate_gain;
      gate_gain < 0.0001 ? gate_gain = 0.0;
    );
    spl0 *= gate_gain; spl1 *= gate_gain;
  ) : ( gate_gain = 1.0; );
);
