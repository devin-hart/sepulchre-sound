// sepulchre_ui_panels.jsfx-inc
// Crypt layout: logo + preset header, then seven stone slabs (eight numbered stages) in signal order:
// Fixed chain (Round 42/43): I INPUT, II DISTORTION, III EQUALIZER, IV AMP, V CHORUS, VI REVERB (amp FX loop),
// VII CABINET / VIII OUTPUT.
// Slab and header-band geometry must match the baked sepulchre_bg.jpg.
@init

UI_DIM = 0.28;
UI_BODY_Y = 158;     // first control row (slab top 106 + 40 header + 12 padding)

// Load an EQ preset (values: eq_preset_vals in sepulchre_presets.jsfx-inc). Turns the EQ on; record curves go after the
// pedal, where their Level was loudness-matched (Round 39); Spectre goes before it (eq_preset_pos, Round 58).
function recall_eq_preset(i) local(k) (
  eq_preset_vals(i);                                           // table in sepulchre_presets.jsfx-inc
  i > 0 ? ( slider65 = 1; slider76 = eq_preset_pos(i); auto_slider(76, 1); );
  slider75 = i; eq_last_preset = i; eq_dirty = 0;
  k = 65; loop(9, auto_slider(k, 1); k += 1; ); auto_slider(75, 1);
  snap_all_sliders();
  ui_need_sync = 1;
);

// Column layout: spread items over the body height, gap clamped to 12..30
function lay_begin(tot, n) ( ui_cy = UI_BODY_Y; ui_gap = clamp((320 - tot) / max(1, n - 1), 12, 30); );
function lay(h) local(y) ( y = ui_cy; ui_cy += h + ui_gap; y; );

// Header strip of a slab: numeral + name sprites, optional power LED
function ui_slab_head(x, w, num_i, name_i, alpha, has_power, on) local(hit) (
  ui_alpha = alpha; ui_title(x + 10, 114, num_i, name_i);
  ui_alpha = 1;
  hit = has_power ? ui_power_led(x + w - 21, 121, on) : 0;
  hit;
);
// ---------- I: Input & gate ----------
function panel_input(x, w) local(ix, iw, g, y) (
  ui_slab_head(x, w, 0, 0, 1, 0, 0);
  ix = x + 10; iw = w - 20; g = slider4 > 0.5;
  lay_begin(154, 5);
  slider1 = ui_hslider(1, ix, lay(30), iw, "TRIM", slider1, -12, 18, 0, 0.1, "%+.1f dB", 0);
  slider2 = ui_hslider(2, ix, lay(30), iw, "LOW CUT", slider2, 40, 180, 130, 1, "%d Hz", 0);
  ui_toggle(ix, lay(24), iw, 24, g ? "NOISE GATE  ON" : "NOISE GATE  OFF", g) ? set_param(4, !g);
  ui_alpha = g ? 1 : UI_DIM;
  y = lay(30);
  slider3 = ui_hslider(3, ix, y, iw, "THRESHOLD", slider3, -80, -30, -50, 0.5, "%.1f dB", 0);
  f_label(); gate_gain > 0.5 ? c_thumb() : c_ember();                 // gate state LED after the label
  gfx_circle(ui_ox + (ix + u_tw_sp("THRESHOLD", 1.6) + 9) * ui_S, ui_oy + (y + 7) * ui_S, 2.5 * ui_S, 1, 1);   // Round 63: round gate lamp
  ui_alpha = 1;
  ui_meter(ix, lay(40), iw, "INPUT", meter_in_peak, g ? slider3 : -999, -18);   // Round 55: aim peaks at -18..-6
);

// GE-7 style vertical fader (bipolar, centre detent). Returns the new value; reports hover/drag in ui_vs_hot.
function ui_vslider(id, x, y, h, label, val, min_v, max_v, dflt_v, step_v) local(norm, new_val, now_t, cy, fy) (
  new_val = val;
  ui_last_drag_id == id && !(mouse_cap & 1) ? auto_slider(id, 1);
  ui_hit(x - 6, y - 4, 13, h + 8) ? (
    time_precise(now_t);
    (ui_last_click_id == id && (now_t - ui_last_click_t) < 0.32) ? (
      new_val = dflt_v; set_param(id, new_val); ui_drag_id = 0; ui_last_click_id = 0;
    ) : ( ui_drag_id = id; ui_drag_start_y = ui_my; ui_drag_start_v = val; ui_last_click_id = id; ui_last_click_t = now_t; );
  );
  !ui_dropdown_open && mouse_wheel != 0 && mouse_in(x - 6, y - 4, 13, h + 8) ? (
    new_val = clamp(val + (mouse_wheel > 0 ? 1 : -1) * step_v, min_v, max_v); mouse_wheel = 0;
    new_val != val ? set_param(id, new_val);
  );
  ui_drag_id == id && (mouse_cap & 1) ? (
    (mouse_cap & 8) ? ( new_val = ui_drag_start_v - (ui_my - ui_drag_start_y) / (h * 5.0) * (max_v - min_v);
                        ui_drag_start_y = ui_my; ui_drag_start_v = new_val; )
                    : ( new_val = max_v - clamp((ui_my - y) / h, 0, 1) * (max_v - min_v); );
    new_val = clamp(floor(new_val / step_v + 0.5) * step_v, min_v, max_v);
    new_val != val ? ( slider(id) = new_val; sl_snap[id] = new_val; auto_slider(id, 0); ui_need_sync = 1; preset_dirty = 1; );
  );
  new_val != val ? eq_dirty = 1;                       // a fader moved: EQ preset name gets a '*'
  (ui_drag_id == id || mouse_in(x - 6, y - 4, 13, h + 8)) ? ( ui_vs_hot = id; ui_vs_val = new_val; ui_vs_lab = label; );
  norm = clamp((new_val - min_v) / (max_v - min_v), 0, 1); fy = y + (1 - norm) * h; cy = y + h * 0.5;
  u_carve(x - 2, y, 5, h);                                    // Round 60: chiselled groove
  c_det(); u_rect(x - 4, cy - 0.5, 9, 1);
  c_fill(); u_rect(x - 1, min(cy, fy), 3, max(1, abs(fy - cy)));
  c_shade(); u_rect(x - 5, fy - 1.5, 12, 5); c_thumb(); u_rect(x - 6, fy - 2.5, 12, 5);   // bone chip + shadow
  f_tiny(); c_lab(); u_text(x - u_tw(label) * 0.5, y + h + 8, label);
  new_val;
);

// ---------- Pedal / EQ / chorus / reverb panels ----------
function panel_mod(mod_id, num_i, x, w) local(ix, iw, en, bw, a, y, p, n) (
  ix = x + 10; iw = w - 20;
  en = mod_id == 0 ? slider10 > 0.5 : mod_id == 1 ? slider20 > 0.5 : mod_id == 3 ? slider40 > 0.5 : slider65 > 0.5;
  a = en ? 1 : UI_DIM;
  ui_slab_head(x, w, num_i, mod_id == 4 ? 8 : mod_id + 1, a, 1, en)
    ? set_param(mod_id == 0 ? 10 : mod_id == 1 ? 20 : mod_id == 3 ? 40 : 65, !en);
  ui_alpha = a;

  mod_id == 0 ? (
    p = floor(slider11 + 0.5);
    n = p == 2 ? 6 : p == 3 ? 4 : 3;
    lay_begin(36 + n * 30, n + 2); y = lay(24); bw = (iw - 9) / 4;
    ui_seg(ix, y, bw, 24, "RAT", p == 0) ? set_param(11, 0);
    ui_seg(ix + (bw + 3), y, bw, 24, "DS-1", p == 1) ? set_param(11, 1);
    ui_seg(ix + 2 * (bw + 3), y, bw, 24, "MT-2", p == 2) ? set_param(11, 2);
    ui_seg(ix + 3 * (bw + 3), y, bw, 24, "HM-2", p == 3) ? set_param(11, 3);
    y = lay(12); f_tiny(); c_lab();
    u_text_sp(ix, y, p == 0 ? "LM308 OP-AMP / 1N914 DIODES" : p == 1 ? "BOOSTER + OP-AMP / 1N4148"
                   : p == 2 ? "MID HUMP + GAIN STAGE / SI PAIR" : "TS STAGE + GE CORING / SI PAIR", 0.6);
    p == 0 ? (
      slider26 = ui_hslider(26, ix, lay(30), iw, "DISTORTION", slider26, 0, 10, 8, 0.1, "%.1f", 0);
      slider27 = ui_hslider(27, ix, lay(30), iw, "FILTER", slider27, 0, 10, 3.5, 0.1, "%.1f", 0);
      slider28 = ui_hslider(28, ix, lay(30), iw, "VOLUME", slider28, 0, 10, 6.7, 0.1, "%.1f", 0);
    ) : p == 1 ? (
      slider29 = ui_hslider(29, ix, lay(30), iw, "DIST", slider29, 0, 10, 10, 0.1, "%.1f", 0);
      slider37 = ui_hslider(37, ix, lay(30), iw, "TONE", slider37, 0, 10, 7.5, 0.1, "%.1f", 0);
      slider38 = ui_hslider(38, ix, lay(30), iw, "LEVEL", slider38, 0, 10, 8, 0.1, "%.1f", 0);
    ) : p == 2 ? (
      slider39 = ui_hslider(39, ix, lay(30), iw, "DIST", slider39, 0, 10, 5.5, 0.1, "%.1f", 0);
      slider46 = ui_hslider(46, ix, lay(30), iw, "HIGH", slider46, 0, 10, 5.8, 0.1, "%+.1f dB", 4);
      slider47 = ui_hslider(47, ix, lay(30), iw, "LOW", slider47, 0, 10, 4.2, 0.1, "%+.1f dB", 4);
      slider48 = ui_hslider(48, ix, lay(30), iw, "MIDDLE", slider48, 0, 10, 6, 0.1, "%+.1f dB", 3);
      slider59 = ui_hslider(59, ix, lay(30), iw, "MID FREQ", slider59, 0, 10, 4.8, 0.1, "%d Hz", -1);
      slider61 = ui_hslider(61, ix, lay(30), iw, "LEVEL", slider61, 0, 10, 7.0, 0.1, "%.1f", 0);
    ) : (
      slider62 = ui_hslider(62, ix, lay(30), iw, "DISTORTION", slider62, 0, 10, 10, 0.1, "%.1f", 0);
      slider63 = ui_hslider(63, ix, lay(30), iw, "LOW", slider63, 0, 10, 10, 0.1, "%.1f", 0);
      slider64 = ui_hslider(64, ix, lay(30), iw, "HIGH", slider64, 0, 10, 10, 0.1, "%.1f", 0);
      slider9 = ui_hslider(9, ix, lay(30), iw, "LEVEL", slider9, 0, 10, 4.4, 0.1, "%.1f", 0);
    );
  ) : mod_id == 1 ? (
    lay_begin(72, 3); f_tiny(); c_lab(); u_text_sp(ix, lay(12), "BOSS CE-2  /  MN3007 BBD", 0.6);   // Round 42
    slider77 = ui_hslider(77, ix, lay(30), iw, "RATE", slider77, 0, 10, 4.5, 0.1, "%.1f", 0);
    slider78 = ui_hslider(78, ix, lay(30), iw, "DEPTH", slider78, 0, 10, 4, 0.1, "%.1f", 0);
  ) : mod_id == 4 ? (                                   // GE-7: seven band faders + level
    ui_vs_hot = 0; n = floor(slider75 + 0.5);                // Round 34: record EQ presets, < > to step
    c_border(); u_rect(ix, UI_BODY_Y + 19, iw, 1);              // Round 64: hairline, no box
    ui_hit(ix, UI_BODY_Y - 4, 20, 24) ? recall_eq_preset(n > 0 ? n - 1 : EQ_COUNT);
    ui_hit(ix + iw - 20, UI_BODY_Y - 4, 20, 24) ? recall_eq_preset(n < EQ_COUNT ? n + 1 : 0);
    f_value(); c_fill(); u_text(ix + 5, UI_BODY_Y, "<"); u_text_r(ix + iw - 5, UI_BODY_Y, ">");
    f_tiny(); c_bone(); strcpy(#eq_pn, get_eq_preset_name(n)); eq_dirty && n > 0 ? strcat(#eq_pn, " *");
    u_text_sp_c(ix + iw * 0.5, UI_BODY_Y + 8, #eq_pn, 0.6);
    bw = (iw - 3) / 2;                                       // Round 42: EQ before / after the pedal
    ui_seg(ix, UI_BODY_Y + 26, bw, 20, "PRE PEDAL", slider76 < 0.5) ? ( set_param(76, 0); eq_dirty = 1; );
    ui_seg(ix + bw + 3, UI_BODY_Y + 26, bw, 20, "POST PEDAL", slider76 > 0.5) ? ( set_param(76, 1); eq_dirty = 1; );
    p = 0;
    loop(8,
      y = ix + 8 + p * ((iw - 16) / 7);
      slider(66 + p) = ui_vslider(66 + p, y, UI_BODY_Y + 76, 182,
        p == 0 ? "100" : p == 1 ? "200" : p == 2 ? "400" : p == 3 ? "800" : p == 4 ? "1.6K" : p == 5 ? "3.2K" : p == 6 ? "6.4K" : "LVL",
        slider(66 + p), -15, 15, 0, 0.5);
      p += 1;
    );
    f_value(); c_bone();
    ui_vs_hot ? sprintf(#eq_v, "%s  %+.1f dB", ui_vs_lab, ui_vs_val) : strcpy(#eq_v, "+15 / 0 / -15 dB");
    u_text_r(ix + iw, UI_BODY_Y + 54, #eq_v);
  ) : (
    lay_begin(144, 5); y = lay(24); bw = (iw - 6) / 3; p = floor(slider41 + 0.5);
    ui_seg(ix, y, bw, 24, "HALL", p == 0) ? set_param(41, 0);
    ui_seg(ix + bw + 3, y, bw, 24, "PLATE", p == 1) ? set_param(41, 1);
    ui_seg(ix + 2 * (bw + 3), y, bw, 24, "AMBIENT", p == 2) ? set_param(41, 2);
    slider42 = ui_hslider(42, ix, lay(30), iw, "DECAY", slider42, 0.5, 10.0, 1.4, 0.1, "%.1f s", 0);
    slider43 = ui_hslider(43, ix, lay(30), iw, "PRE-DELAY", slider43, 0, 60, 14, 1, "%d ms", 0);
    slider44 = ui_hslider(44, ix, lay(30), iw, "DAMPING", slider44, 0, 100, 62, 1, "%d%%", 0);
    slider45 = ui_hslider(45, ix, lay(30), iw, "MIX", slider45, 0, 100, 8, 1, "%d%%", 0);
  );
  ui_alpha = 1;
);

// ---------- IV: Amp ----------
function panel_amp(x, w) local(ix, iw, on, bw, y, m) (
  ix = x + 10; iw = w - 20; m = floor(slider54 + 0.5); on = m > 0;
  ui_slab_head(x, w, 3, 5, on ? 1 : UI_DIM, 0, 0);
  ui_alpha = 1; lay_begin(114, 4); y = lay(24); bw = (iw - 6) / 3;
  ui_seg(ix, y, bw, 24, "OFF", m == 0) ? set_param(54, 0);
  ui_seg(ix + bw + 3, y, bw, 24, "TUBE", m == 1) ? set_param(54, 1);
  ui_seg(ix + 2 * (bw + 3), y, bw, 24, "SOLID", m == 2) ? set_param(54, 2);
  ui_alpha = on ? 1 : UI_DIM;
  slider55 = ui_hslider(55, ix, lay(30), iw, "BASS", slider55, 0, 100, 46, 1, "%+.1f dB", 0.20);
  slider56 = ui_hslider(56, ix, lay(30), iw, "MID", slider56, 0, 100, 52, 1, "%+.1f dB", 0.22);
  slider57 = ui_hslider(57, ix, lay(30), iw, "TREBLE", slider57, 0, 100, 58, 1, "%+.1f dB", 0.20);
  ui_alpha = 1;
);

// ---------- VII: Cabinet + VIII: Output (fixed rows; OUTPUT band is baked at y 246..280) ----------
function panel_cab_out(x, w) local(ix, iw, on, k) (
  ix = x + 10; iw = w - 20; on = slider49 > 0.5;
  ui_slab_head(x, w, 6, 6, on ? 1 : UI_DIM, 1, on) ? set_param(49, !on);
  ui_alpha = on ? 1 : UI_DIM;                              // Round 42/68: user WAV IRs (built-in 4x12 fallback)
  !ir_counted ? ( scan_ir_count(); ir_counted = 1; );
  k = max(0, floor(slider53 + 0.5));
  c_border(); u_rect(ix, 195, iw, 1);                         // Round 64: hairline, no box
  ui_hit(ix, 162, 22, 34) && k > 0 ? set_param(53, k - 1);
  ui_hit(ix + iw - 22, 162, 22, 34) && ir_file_count > 0 && k < ir_file_count - 1 ? set_param(53, k + 1);
  f_value(); c_fill(); u_text(ix + 6, 170, "<"); u_text_r(ix + iw - 6, 170, ">");
  ir_filter_len > 0 ? ( ir_file_count > 0 ? sprintf(#ir_n, "IR %d / %d", k + 1, ir_file_count) : sprintf(#ir_n, "IR %d", k + 1); )
                    : strcpy(#ir_n, "BUILT-IN 4x12 (NO IR)");
  f_label(); c_bone(); u_text_sp_c(ix + iw * 0.5, 173, #ir_disp, 0.5);
  f_tiny(); ir_filter_len > 0 ? c_lab() : c_ember(); u_text_sp_c(ix + iw * 0.5, 187, #ir_n, ir_filter_len > 0 ? 1.5 : 0.4);

  ui_alpha = 1;
  ui_title(x + 10, 251, 7, 7);
  slider58 = ui_hslider(58, ix, 290, iw, "AIR", slider58, 0, 100, 56, 1, "%+.1f dB", 0.24);
  slider51 = ui_hslider(51, ix, 340, iw, "MASTER", slider51, -24, 6, 2.3, 0.1, "%+.1f dB", 0);
  ui_meter(ix, 396, iw, "OUTPUT", meter_out_peak, -999, 0);
);

// ---------- Header + whole frame ----------
function ui_header() (
  ui_alpha = 1;
  draw_preset_dropdown_bar(936, 36, 250, 28);
  f_small(); u_rgb(125, 120, 111);
  pdc_delay > 0 ? sprintf(#hdr, "8x OVERSAMPLED  /  IR LATENCY %d SPL (%.1f MS)", pdc_delay, pdc_delay * 1000 / srate)
                : strcpy(#hdr, "8x OVERSAMPLED  /  ZERO LATENCY");
  u_text_sp(1186 - u_tw_sp(#hdr, 1.5), 76, #hdr, 1.5);
);
function ui_draw_all() (
  ui_header();
  panel_input(14, 150);
  panel_mod(0, 1, 174, 162);                               // II   DISTORTION
  panel_mod(4, 2, 346, 162);                               // III  EQUALIZER
  panel_amp(518, 162);                                     // IV   AMP
  panel_mod(1, 4, 690, 162);                               // V    CHORUS   } amp FX loop
  panel_mod(3, 5, 862, 150);                               // VI   REVERB   }
  panel_cab_out(1022, 168);                                // VII  CABINET / VIII OUTPUT
  draw_preset_dropdown_menu(936, 66, 250, 24);
);
