// sepulchre_ui_panels.jsfx-inc
// Crypt layout: logo + preset header, then eight numbered stages on stone slabs in signal order:
// I INPUT -> II..V swappable slots -> VI AMP -> VII CABINET / VIII OUTPUT.
// Slab and header-band geometry must match the baked sepulchre_bg.jpg.
@init

UI_DIM = 0.28;
UI_BODY_Y = 158;     // first control row (slab top 106 + 40 header + 12 padding)

// Column layout: spread items over the body height, gap clamped to 12..30
function lay_begin(tot, n) ( ui_cy = UI_BODY_Y; ui_gap = clamp((320 - tot) / max(1, n - 1), 12, 30); );
function lay(h) local(y) ( y = ui_cy; ui_cy += h + ui_gap; y; );

// Header strip of a slab: numeral + name sprites, optional power LED, optional MOVE arrows on hover
function ui_slab_head(x, w, num_i, name_i, alpha, has_power, on) local(hit) (
  ui_alpha = alpha; ui_title(x + 10, 114, num_i, name_i);
  ui_alpha = 1;
  hit = has_power ? ui_power_led(x + w - 21, 121, on) : 0;
  hit;
);
function ui_move_arrows(slot_idx, x, w) (
  ui_alpha = 1;
  mouse_in(x, 106, w, 40) && !ui_dropdown_open ? (
    slot_idx > 0 ? (
      u_rgb(14, 14, 14); u_rect(x + 1, 107, 22, 38);
      ui_seg(x + 3, 116, 18, 20, "<", 0) ? swap_routing_slots(slot_idx - 1, slot_idx);
    );
    slot_idx < 3 ? (
      u_rgb(14, 14, 14); u_rect(x + w - 50, 107, 24, 38);
      ui_seg(x + w - 48, 116, 18, 20, ">", 0) ? swap_routing_slots(slot_idx, slot_idx + 1);
    );
  );
);

// ---------- I: Input & gate ----------
function panel_input(x, w) local(ix, iw, g, y) (
  ui_slab_head(x, w, 0, 0, 1, 0, 0);
  ix = x + 10; iw = w - 20; g = slider4 > 0.5;
  lay_begin(244, 8);
  slider1 = ui_hslider(1, ix, lay(30), iw, "TRIM", slider1, -12, 18, 0, 0.1, "%+.1f dB", 0);
  slider2 = ui_hslider(2, ix, lay(30), iw, "LOW CUT", slider2, 40, 180, 105, 1, "%d Hz", 0);
  slider13 = ui_hslider(13, ix, lay(30), iw, "EQ LOW", slider13, 0, 100, 50, 1, "%+.1f dB", 0.24);
  slider14 = ui_hslider(14, ix, lay(30), iw, "EQ MID", slider14, 0, 100, 50, 1, "%+.1f dB", 0.28);
  slider15 = ui_hslider(15, ix, lay(30), iw, "EQ HIGH", slider15, 0, 100, 50, 1, "%+.1f dB", 0.24);
  ui_toggle(ix, lay(24), iw, 24, g ? "NOISE GATE  ON" : "NOISE GATE  OFF", g) ? set_param(4, !g);
  ui_alpha = g ? 1 : UI_DIM;
  y = lay(30);
  slider3 = ui_hslider(3, ix, y, iw, "THRESHOLD", slider3, -80, -30, -52, 0.5, "%.1f dB", 0);
  f_label(); gate_gain > 0.5 ? c_thumb() : c_ember();                 // gate state LED after the label
  u_rect(ix + u_tw_sp("THRESHOLD", 1.6) + 6, y + 4, 6, 6);
  ui_alpha = 1;
  ui_meter(ix, lay(40), iw, "INPUT", meter_in_peak, g ? slider3 : -999, 0);
);

// ---------- II..V: swappable slots ----------
function panel_slot(mod_id, slot_idx, x, w) local(ix, iw, en, bw, div, a, y, p, n) (
  ix = x + 10; iw = w - 20;
  en = mod_id == 0 ? slider10 > 0.5 : mod_id == 1 ? slider20 > 0.5 : mod_id == 2 ? slider30 > 0.5 : slider40 > 0.5;
  a = en ? 1 : UI_DIM;
  ui_slab_head(x, w, slot_idx + 1, mod_id + 1, a, 1, en) ? set_param(mod_id == 0 ? 10 : mod_id == 1 ? 20 : mod_id == 2 ? 30 : 40, !en);
  ui_alpha = a;

  mod_id == 0 ? (
    p = floor(slider11 + 0.5);
    n = p == 2 ? 6 : p == 3 ? 4 : 3;
    lay_begin(36 + n * 30, n + 2); y = lay(24); bw = (iw - 9) / 4;
    ui_seg(ix, y, bw, 24, "RAT", p == 0) ? set_param(11, 0);
    ui_seg(ix + (bw + 3), y, bw, 24, "DS-1", p == 1) ? set_param(11, 1);
    ui_seg(ix + 2 * (bw + 3), y, bw, 24, "MT-2", p == 2) ? set_param(11, 2);
    ui_seg(ix + 3 * (bw + 3), y, bw, 24, "HM-2", p == 3) ? set_param(11, 3);
    y = lay(12); f_tiny(); c_lab();
    u_text_sp(ix, y, p == 0 ? "LM308 OP-AMP / 1N914 DIODES" : p == 1 ? "BOOSTER + OP-AMP / 1N4148"
                   : p == 2 ? "MID HUMP + 2 GAIN STAGES" : "PREGAIN + 2 CLIPPER PAIRS", 0.6);
    p == 0 ? (
      slider26 = ui_hslider(26, ix, lay(30), iw, "DISTORTION", slider26, 0, 10, 8, 0.1, "%.1f", 0);
      slider27 = ui_hslider(27, ix, lay(30), iw, "FILTER", slider27, 0, 10, 3.5, 0.1, "%.1f", 0);
      slider28 = ui_hslider(28, ix, lay(30), iw, "VOLUME", slider28, 0, 10, 6, 0.1, "%.1f", 0);
    ) : p == 1 ? (
      slider29 = ui_hslider(29, ix, lay(30), iw, "DIST", slider29, 0, 10, 9, 0.1, "%.1f", 0);
      slider37 = ui_hslider(37, ix, lay(30), iw, "TONE", slider37, 0, 10, 6.5, 0.1, "%.1f", 0);
      slider38 = ui_hslider(38, ix, lay(30), iw, "LEVEL", slider38, 0, 10, 6, 0.1, "%.1f", 0);
    ) : p == 2 ? (
      slider39 = ui_hslider(39, ix, lay(30), iw, "DIST", slider39, 0, 10, 7.5, 0.1, "%.1f", 0);
      slider46 = ui_hslider(46, ix, lay(30), iw, "HIGH", slider46, 0, 10, 5, 0.1, "%+.1f dB", 4);
      slider47 = ui_hslider(47, ix, lay(30), iw, "LOW", slider47, 0, 10, 5, 0.1, "%+.1f dB", 4);
      slider48 = ui_hslider(48, ix, lay(30), iw, "MIDDLE", slider48, 0, 10, 5, 0.1, "%+.1f dB", 3);
      slider59 = ui_hslider(59, ix, lay(30), iw, "MID FREQ", slider59, 0, 10, 4.5, 0.1, "%d Hz", -1);
      slider61 = ui_hslider(61, ix, lay(30), iw, "LEVEL", slider61, 0, 10, 5, 0.1, "%.1f", 0);
    ) : (
      slider62 = ui_hslider(62, ix, lay(30), iw, "DISTORTION", slider62, 0, 10, 10, 0.1, "%.1f", 0);
      slider63 = ui_hslider(63, ix, lay(30), iw, "LOW", slider63, 0, 10, 10, 0.1, "%.1f", 0);
      slider64 = ui_hslider(64, ix, lay(30), iw, "HIGH", slider64, 0, 10, 10, 0.1, "%.1f", 0);
      slider9 = ui_hslider(9, ix, lay(30), iw, "LEVEL", slider9, 0, 10, 6, 0.1, "%.1f", 0);
    );
  ) : mod_id == 1 ? (
    lay_begin(144, 5); y = lay(24); bw = (iw - 3) / 2;
    ui_seg(ix, y, bw, 24, "BBD", slider21 == 0) ? set_param(21, 0);
    ui_seg(ix + bw + 3, y, bw, 24, "DIMENSION", slider21 == 1) ? set_param(21, 1);
    slider22 = ui_hslider(22, ix, lay(30), iw, "RATE", slider22, 0.1, 4.0, 0.45, 0.05, "%.2f Hz", 0);
    slider23 = ui_hslider(23, ix, lay(30), iw, "DEPTH", slider23, 0, 100, 58, 1, "%d%%", 0);
    slider24 = ui_hslider(24, ix, lay(30), iw, "TONE", slider24, 0, 100, 44, 1, "%d%%", 0);
    slider25 = ui_hslider(25, ix, lay(30), iw, "MIX", slider25, 0, 100, 38, 1, "%d%%", 0);
  ) : mod_id == 2 ? (
    lay_begin(198, 6); y = lay(24); bw = (iw - 3) / 2;
    ui_seg(ix, y, bw, 24, "TAPE", slider31 == 0) ? set_param(31, 0);
    ui_seg(ix + bw + 3, y, bw, 24, "DIGITAL", slider31 == 1) ? set_param(31, 1);
    ui_toggle(ix, lay(24), iw, 24, slider36 > 0.5 ? "TEMPO SYNC  ON" : "TEMPO SYNC  OFF", slider36 > 0.5) ? set_param(36, !(slider36 > 0.5));
    y = lay(30);
    slider36 > 0.5 ? (
      div = get_delay_sync_div(slider32); bw = (iw - 9) / 4;
      ui_seg(ix, y, bw, 18, "1/8", div < 0.55) ? set_param(32, 120);
      ui_seg(ix + (bw + 3), y, bw, 18, "1/4T", div >= 0.55 && div < 0.70) ? set_param(32, 260);
      ui_seg(ix + 2 * (bw + 3), y, bw, 18, "1/8.", div >= 0.70 && div < 0.85) ? set_param(32, 420);
      ui_seg(ix + 3 * (bw + 3), y, bw, 18, "1/4", div >= 0.85) ? set_param(32, 650);
      f_small(); c_lab(); sprintf(#sync_lbl, "= %d MS", floor(delay_eff_ms + 0.5)); u_text_r(ix + iw, y + 21, #sync_lbl);
    ) : (
      slider32 = ui_hslider(32, ix, y, iw, "TIME", slider32, 20, 800, 390, 1, "%d ms", 0);
    );
    slider33 = ui_hslider(33, ix, lay(30), iw, "FEEDBACK", slider33, 0, 105, 42, 1, "%d%%", 0);
    slider34 = ui_hslider(34, ix, lay(30), iw, "TONE", slider34, 0, 100, 36, 1, "%d%%", 0);
    slider35 = ui_hslider(35, ix, lay(30), iw, "MIX", slider35, 0, 100, 28, 1, "%d%%", 0);
  ) : (
    lay_begin(144, 5); y = lay(24); bw = (iw - 6) / 3;
    ui_seg(ix, y, bw, 24, "HALL", slider41 == 0) ? set_param(41, 0);
    ui_seg(ix + bw + 3, y, bw, 24, "PLATE", slider41 == 1) ? set_param(41, 1);
    ui_seg(ix + 2 * (bw + 3), y, bw, 24, "AMBIENT", slider41 == 2) ? set_param(41, 2);
    slider42 = ui_hslider(42, ix, lay(30), iw, "DECAY", slider42, 0.5, 10.0, 3.2, 0.1, "%.1f s", 0);
    slider43 = ui_hslider(43, ix, lay(30), iw, "PRE-DELAY", slider43, 0, 60, 22, 1, "%d ms", 0);
    slider44 = ui_hslider(44, ix, lay(30), iw, "DAMPING", slider44, 0, 100, 62, 1, "%d%%", 0);
    slider45 = ui_hslider(45, ix, lay(30), iw, "MIX", slider45, 0, 100, 26, 1, "%d%%", 0);
  );
  ui_move_arrows(slot_idx, x, w);
  ui_alpha = 1;
);

// ---------- VI: Amp ----------
function panel_amp(x, w) local(ix, iw, on, bw, y) (
  ix = x + 10; iw = w - 20; on = slider54 > 0.5;
  ui_slab_head(x, w, 5, 5, on ? 1 : UI_DIM, 0, 0);
  ui_alpha = 1; lay_begin(114, 4); y = lay(24); bw = (iw - 6) / 3;
  ui_seg(ix, y, bw, 24, "OFF", slider54 == 0) ? set_param(54, 0);
  ui_seg(ix + bw + 3, y, bw, 24, "TUBE", slider54 == 1) ? set_param(54, 1);
  ui_seg(ix + 2 * (bw + 3), y, bw, 24, "SOLID", slider54 == 2) ? set_param(54, 2);
  ui_alpha = on ? 1 : UI_DIM;
  slider55 = ui_hslider(55, ix, lay(30), iw, "BASS", slider55, 0, 100, 50, 1, "%+.1f dB", 0.20);
  slider56 = ui_hslider(56, ix, lay(30), iw, "MID", slider56, 0, 100, 50, 1, "%+.1f dB", 0.22);
  slider57 = ui_hslider(57, ix, lay(30), iw, "TREBLE", slider57, 0, 100, 50, 1, "%+.1f dB", 0.20);
  ui_alpha = 1;
);

// ---------- VII: Cabinet + VIII: Output (fixed rows; OUTPUT band is baked at y 246..280) ----------
function panel_cab_out(x, w) local(ix, iw, on, bw, k) (
  ix = x + 10; iw = w - 20; on = slider49 > 0.5;
  ui_slab_head(x, w, 6, 6, on ? 1 : UI_DIM, 1, on) ? set_param(49, !on);
  ui_alpha = on ? 1 : UI_DIM; bw = (iw - 3) / 2;
  ui_seg(ix, 158, bw, 24, "IIR CAB", slider52 < 0.5) ? set_param(52, 0);
  ui_seg(ix + bw + 3, 158, bw, 24, "WAV IR", slider52 > 0.5) ? set_param(52, 1);
  slider52 < 0.5 ? (
    bw = (iw - 6) / 3;
    ui_seg(ix, 198, bw, 26, "4x12", slider50 == 0) ? set_param(50, 0);
    ui_seg(ix + bw + 3, 198, bw, 26, "2x12", slider50 == 1) ? set_param(50, 1);
    ui_seg(ix + 2 * (bw + 3), 198, bw, 26, "DAMPED", slider50 == 2) ? set_param(50, 2);
  ) : (
    k = floor(slider53 + 0.5);
    c_border(); u_frame(ix, 194, iw, 34);
    ui_hit(ix, 194, 22, 34) ? set_param(53, max(0, k - 1));
    ui_hit(ix + iw - 22, 194, 22, 34) ? set_param(53, min(9, k + 1));
    f_value(); c_fill(); u_text(ix + 6, 202, "<"); u_text_r(ix + iw - 6, 202, ">");
    sprintf(#ir_n, "SLOT %d / 10", k + 1);
    f_label(); c_bone(); u_text_sp_c(ix + iw * 0.5, 205, get_ir_slot_name(k), 0.5);
    f_tiny(); c_lab(); u_text_sp_c(ix + iw * 0.5, 219, #ir_n, 1.5);
  );

  ui_alpha = 1;
  ui_title(x + 10, 251, 7, 7);
  slider58 = ui_hslider(58, ix, 290, iw, "AIR", slider58, 0, 100, 50, 1, "%+.1f dB", 0.24);
  slider16 = ui_hslider(16, ix, 334, iw, "LO-FI GRIT", slider16, 0, 100, 0, 1, "%d%%", 0);
  slider51 = ui_hslider(51, ix, 378, iw, "MASTER", slider51, -24, 6, -0.5, 0.1, "%+.1f dB", 0);
  ui_meter(ix, 418, iw, "OUTPUT", meter_out_peak, -999, 1);
  f_tiny(); c_tick(); u_text_sp(ix, 467, "TARGET  -10 / -8 dBFS", 1);
);

// ---------- Header + whole frame ----------
function ui_header() (
  ui_alpha = 1;
  draw_preset_dropdown_bar(936, 36, 250, 28);
  f_small(); u_rgb(125, 120, 111);
  pdc_delay > 0 ? sprintf(#hdr, "4x OVERSAMPLED  /  IR LATENCY %d SPL (%.1f MS)", pdc_delay, pdc_delay * 1000 / srate)
                : strcpy(#hdr, "4x OVERSAMPLED  /  ZERO LATENCY");
  u_text_sp(1186 - u_tw_sp(#hdr, 1.5), 76, #hdr, 1.5);
);
function ui_draw_all() (
  ui_header();
  panel_input(14, 150);
  panel_slot(slider5, 0, 174, 162);
  panel_slot(slider6, 1, 346, 162);
  panel_slot(slider7, 2, 518, 162);
  panel_slot(slider8, 3, 690, 162);
  panel_amp(862, 150);
  panel_cab_out(1022, 168);
  draw_preset_dropdown_menu(936, 66, 250, 24);
);
