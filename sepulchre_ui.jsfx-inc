// sepulchre_ui.jsfx-inc
// Dark industrial pedalboard UI: strictly horizontal sliders and click toggles, zero rotary knobs

function set_rgb(r, g, b) (
  gfx_r = r / 255.0; gfx_g = g / 255.0; gfx_b = b / 255.0; gfx_a = 1.0;
);

function col_bg()      ( set_rgb(17, 17, 19); );    // #111113 Charcoal/Obsidian
function col_chassis() ( set_rgb(26, 26, 30); );    // #1A1A1E Dark Chassis
function col_header()  ( set_rgb(33, 33, 39); );    // #212127 Header Bar
function col_steel()   ( set_rgb(46, 46, 54); );    // #2E2E36 Steel Border
function col_crimson() ( set_rgb(168, 32, 40); );   // #A82028 Crimson Highlight
function col_bone()    ( set_rgb(208, 206, 200); ); // #D0CEC8 Bone-Silver Text
function col_dim()     ( set_rgb(122, 120, 116); ); // #7A7874 Dimmed Label

function draw_box(x, y, w, h, fill_mode) (
  fill_mode ? gfx_rect(x, y, w, h) : (
    gfx_line(x, y, x + w - 1, y);
    gfx_line(x + w - 1, y, x + w - 1, y + h - 1);
    gfx_line(x + w - 1, y + h - 1, x, y + h - 1);
    gfx_line(x, y + h - 1, x, y);
  );
);

function mouse_in(x, y, w, h) (
  mouse_x >= x && mouse_x <= (x + w) && mouse_y >= y && mouse_y <= (y + h);
);

// Click toggle button: returns 1 if clicked on this frame
function ui_button(x, y, w, h, label, active) local(clicked, tw, th) (
  clicked = ui_mouse_clicked && mouse_in(x, y, w, h);
  active ? col_crimson() : col_bg();
  draw_box(x, y, w, h, 1);
  col_steel();
  draw_box(x, y, w, h, 0);
  active ? col_bone() : col_dim();
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5;
  gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
  clicked;
);

// Strictly horizontal slider widget
function ui_hslider(id, x, y, w, label, val, min_v, max_v, step_v, fmt) local(track_y, track_h, norm, fill_w, thumb_x, new_val, tw, th) (
  gfx_setfont(1, "Consolas", 12, 'b');
  col_dim();
  gfx_x = x; gfx_y = y;
  gfx_drawstr(label);

  col_bone();
  sprintf(#val_str, fmt, val);
  gfx_measurestr(#val_str, tw, th);
  gfx_x = x + w - tw; gfx_y = y;
  gfx_drawstr(#val_str);

  track_y = y + 15;
  track_h = 10;

  ui_mouse_clicked && mouse_in(x - 2, track_y - 3, w + 4, track_h + 6) ? (
    ui_drag_id = id;
  );

  new_val = val;
  ui_drag_id == id && (mouse_cap & 1) ? (
    norm = clamp((mouse_x - x) / w, 0.0, 1.0);
    new_val = min_v + norm * (max_v - min_v);
    step_v > 0 ? new_val = floor(new_val / step_v + 0.5) * step_v;
    new_val = clamp(new_val, min_v, max_v);
    new_val != val ? ui_param_changed = 1;
  );

  norm = clamp((new_val - min_v) / (max_v - min_v), 0.0, 1.0);
  fill_w = floor(norm * w);

  col_bg();
  draw_box(x, track_y, w, track_h, 1);
  fill_w > 0 ? (
    col_crimson();
    draw_box(x + 1, track_y + 1, max(1, fill_w - 1), track_h - 2, 1);
  );
  col_steel();
  draw_box(x, track_y, w, track_h, 0);

  // Bone-silver vertical bar indicator on horizontal track
  thumb_x = clamp(x + fill_w - 2, x, x + w - 4);
  col_bone();
  draw_box(thumb_x, track_y - 1, 4, track_h + 2, 1);

  new_val;
);

function swap_routing_slots(slot_a, slot_b) local(tmp) (
  slot_a == 0 && slot_b == 1 ? ( tmp = slider5; slider5 = slider6; slider6 = tmp; );
  slot_a == 1 && slot_b == 2 ? ( tmp = slider6; slider6 = slider7; slider7 = tmp; );
  slot_a == 2 && slot_b == 3 ? ( tmp = slider7; slider7 = slider8; slider8 = tmp; );
  ui_param_changed = 1;
);

function draw_middle_module(mod_id, slot_idx, x, y, w, h) local(inner_x, inner_w, cy, en) (
  col_chassis(); draw_box(x, y, w, h, 1);
  col_header();  draw_box(x, y, w, 28, 1);
  col_steel();   draw_box(x, y, w, h, 0);
  gfx_line(x, y + 28, x + w, y + 28);

  inner_x = x + 10; inner_w = w - 20;

  // Swap arrows in header
  slot_idx > 0 ? (
    ui_button(x + 6, y + 5, 20, 18, "<", 0) ? swap_routing_slots(slot_idx - 1, slot_idx);
  );
  slot_idx < 3 ? (
    ui_button(x + w - 26, y + 5, 20, 18, ">", 0) ? swap_routing_slots(slot_idx, slot_idx + 1);
  );

  mod_id == 0 ? ( // DIRT
    en = slider10 > 0.5;
    ui_button(x + 30, y + 5, w - 60, 18, en ? "DIRT [ON]" : "DIRT [BYP]", en) ? ( slider10 = !en; ui_param_changed = 1; );
    cy = y + 36;
    ui_button(inner_x, cy, 48, 18, "RODENT", slider11 == 0) ? ( slider11 = 0; ui_param_changed = 1; );
    ui_button(inner_x + 51, cy, 44, 18, "FANG", slider11 == 1) ? ( slider11 = 1; ui_param_changed = 1; );
    ui_button(inner_x + 98, cy, inner_w - 98, 18, "CHAINSAW", slider11 == 2) ? ( slider11 = 2; ui_param_changed = 1; );
    cy += 24;
    ui_button(inner_x, cy, 46, 16, "P1:RASP", dirt_preset_idx == 0) ? recall_dirt_preset(0);
    ui_button(inner_x + 50, cy, 48, 16, "P2:BITE", dirt_preset_idx == 1) ? recall_dirt_preset(1);
    ui_button(inner_x + 102, cy, inner_w - 102, 16, "P3:HM2", dirt_preset_idx == 2) ? recall_dirt_preset(2);
    cy += 24;
    slider12 = ui_hslider(12, inner_x, cy, inner_w, "DRIVE", slider12, 0, 100, 1, "%d%%"); cy += 34;
    slider13 = ui_hslider(13, inner_x, cy, inner_w, "PRE-LOW", slider13, 0, 100, 1, "%d%%"); cy += 34;
    slider14 = ui_hslider(14, inner_x, cy, inner_w, "PRE-MID", slider14, 0, 100, 1, "%d%%"); cy += 34;
    slider15 = ui_hslider(15, inner_x, cy, inner_w, "PRE-HIGH", slider15, 0, 100, 1, "%d%%"); cy += 34;
    slider16 = ui_hslider(16, inner_x, cy, inner_w, "GRIT (DEGRADE)", slider16, 0, 100, 1, "%d%%"); cy += 34;
    slider17 = ui_hslider(17, inner_x, cy, inner_w, "LEVEL", slider17, -18, 12, 0.1, "%+.1f dB");
  ) : mod_id == 1 ? ( // FROST
    en = slider20 > 0.5;
    ui_button(x + 30, y + 5, w - 60, 18, en ? "FROST [ON]" : "FROST [BYP]", en) ? ( slider20 = !en; ui_param_changed = 1; );
    cy = y + 36;
    ui_button(inner_x, cy, inner_w * 0.5 - 2, 18, "ANALOG BBD", slider21 == 0) ? ( slider21 = 0; ui_param_changed = 1; );
    ui_button(inner_x + inner_w * 0.5 + 2, cy, inner_w * 0.5 - 2, 18, "DIMENSION", slider21 == 1) ? ( slider21 = 1; ui_param_changed = 1; );
    cy += 24;
    ui_button(inner_x, cy, 46, 16, "P1:SLOW", frost_preset_idx == 0) ? recall_frost_preset(0);
    ui_button(inner_x + 50, cy, 48, 16, "P2:WIDE", frost_preset_idx == 1) ? recall_frost_preset(1);
    ui_button(inner_x + 102, cy, inner_w - 102, 16, "P3:SICK", frost_preset_idx == 2) ? recall_frost_preset(2);
    cy += 28;
    slider22 = ui_hslider(22, inner_x, cy, inner_w, "RATE", slider22, 0.1, 4.0, 0.05, "%.2f Hz"); cy += 42;
    slider23 = ui_hslider(23, inner_x, cy, inner_w, "DEPTH", slider23, 0, 100, 1, "%d%%"); cy += 42;
    slider24 = ui_hslider(24, inner_x, cy, inner_w, "TONE (DAMP)", slider24, 0, 100, 1, "%d%%"); cy += 42;
    slider25 = ui_hslider(25, inner_x, cy, inner_w, "MIX", slider25, 0, 100, 1, "%d%%");
  ) : mod_id == 2 ? ( // ECHO
    en = slider30 > 0.5;
    ui_button(x + 30, y + 5, w - 60, 18, en ? "ECHO [ON]" : "ECHO [BYP]", en) ? ( slider30 = !en; ui_param_changed = 1; );
    cy = y + 36;
    ui_button(inner_x, cy, inner_w * 0.5 - 2, 18, "TAPE / BBD", slider31 == 0) ? ( slider31 = 0; ui_param_changed = 1; );
    ui_button(inner_x + inner_w * 0.5 + 2, cy, inner_w * 0.5 - 2, 18, "DIGITAL 80S", slider31 == 1) ? ( slider31 = 1; ui_param_changed = 1; );
    cy += 24;
    ui_button(inner_x, cy, 46, 16, "P1:SLAP", echo_preset_idx == 0) ? recall_echo_preset(0);
    ui_button(inner_x + 50, cy, 48, 16, "P2:DARK", echo_preset_idx == 1) ? recall_echo_preset(1);
    ui_button(inner_x + 102, cy, inner_w - 102, 16, "P3:OSC", echo_preset_idx == 2) ? recall_echo_preset(2);
    cy += 26;
    slider32 = ui_hslider(32, inner_x, cy, inner_w, "TIME", slider32, 20, 800, 1, "%d ms"); cy += 36;
    ui_button(inner_x, cy, inner_w, 18, slider36 > 0.5 ? "TEMPO SYNC: ON" : "TEMPO SYNC: OFF", slider36 > 0.5) ? ( slider36 = !(slider36 > 0.5); ui_param_changed = 1; );
    cy += 26;
    slider33 = ui_hslider(33, inner_x, cy, inner_w, "FEEDBACK", slider33, 0, 105, 1, "%d%%"); cy += 38;
    slider34 = ui_hslider(34, inner_x, cy, inner_w, "TONE", slider34, 0, 100, 1, "%d%%"); cy += 38;
    slider35 = ui_hslider(35, inner_x, cy, inner_w, "MIX", slider35, 0, 100, 1, "%d%%");
  ) : ( // CAVERN
    en = slider40 > 0.5;
    ui_button(x + 30, y + 5, w - 60, 18, en ? "CAVERN [ON]" : "CAVERN [BYP]", en) ? ( slider40 = !en; ui_param_changed = 1; );
    cy = y + 36;
    ui_button(inner_x, cy, 48, 18, "CRYPT", slider41 == 0) ? ( slider41 = 0; ui_param_changed = 1; );
    ui_button(inner_x + 51, cy, 48, 18, "PLATE", slider41 == 1) ? ( slider41 = 1; ui_param_changed = 1; );
    ui_button(inner_x + 102, cy, inner_w - 102, 18, "ABYSS", slider41 == 2) ? ( slider41 = 2; ui_param_changed = 1; );
    cy += 24;
    ui_button(inner_x, cy, 46, 16, "P1:HALL", cavern_preset_idx == 0) ? recall_cavern_preset(0);
    ui_button(inner_x + 50, cy, 48, 16, "P2:COLD", cavern_preset_idx == 1) ? recall_cavern_preset(1);
    ui_button(inner_x + 102, cy, inner_w - 102, 16, "P3:VOID", cavern_preset_idx == 2) ? recall_cavern_preset(2);
    cy += 28;
    slider42 = ui_hslider(42, inner_x, cy, inner_w, "DECAY", slider42, 0.5, 10.0, 0.1, "%.1f s"); cy += 42;
    slider43 = ui_hslider(43, inner_x, cy, inner_w, "PRE-DELAY", slider43, 0, 60, 1, "%d ms"); cy += 42;
    slider44 = ui_hslider(44, inner_x, cy, inner_w, "DAMPENING", slider44, 0, 100, 1, "%d%%"); cy += 42;
    slider45 = ui_hslider(45, inner_x, cy, inner_w, "MIX", slider45, 0, 100, 1, "%d%%");
  );
);
