// sepulchre_ui.jsfx-inc
// "Crypt" theme: baked stone/slab/logo background (sepulchre_bg.jpg) + Cinzel title sprites (sepulchre_titles.png),
// with all interactive widgets drawn live on top. Coordinates are in a 1204x500 design space scaled to the window
// (Round 43: back to 1204 / 7 slabs after the delay was removed).
@init

UI_DW = 1204; UI_DH = 500;
gfx_ext_retina = 1;

// ---------- Palette ----------
function u_rgb(r, g, b) ( gfx_r = r / 255; gfx_g = g / 255; gfx_b = b / 255; gfx_a = ui_alpha; );
// Round 60 "decrepit crypt" palette: aged bone, lichen-grey labels, worn stone, dried blood, candle flame
function c_void()   ( u_rgb(9, 9, 8); );
function c_bone()   ( u_rgb(226, 214, 188); );   // values, text (aged bone)
function c_lab()    ( u_rgb(150, 148, 128); );   // labels (lichen grey)
function c_soft()   ( u_rgb(140, 136, 120); );   // unselected button text
function c_border() ( u_rgb(64, 60, 52); );      // stone edge
function c_track()  ( u_rgb(16, 15, 13); );      // chiselled groove floor
function c_fill()   ( u_rgb(150, 140, 118); );   // bone dust in the groove
function c_thumb()  ( u_rgb(232, 220, 192); );   // bone chip
function c_det()    ( u_rgb(96, 90, 78); );      // centre notch, hover edge
function c_ember()  ( u_rgb(230, 150, 62); );    // candle flame: power LEDs, gate threshold
function c_tick()   ( u_rgb(118, 114, 98); );
function c_lip()    ( u_rgb(78, 74, 64); );      // lit lower lip of a carved groove / lit edge of raised stone
function c_shade()  ( u_rgb(4, 4, 3); );         // shadowed edge
function c_stone()  ( u_rgb(38, 36, 31); );      // raised stone face

function f_label() ( gfx_setfont(1, "Bahnschrift", 10.5 * ui_S, 'b'); );
function f_value() ( gfx_setfont(2, "Consolas", 12.5 * ui_S); );
function f_small() ( gfx_setfont(3, "Bahnschrift", 9 * ui_S); );
function f_tiny()  ( gfx_setfont(4, "Bahnschrift", 8.5 * ui_S); );

// ---------- Scaling & primitives ----------
function ui_begin() (
  ui_S = max(0.5, min(gfx_w / UI_DW, gfx_h / UI_DH));
  ui_ox = floor((gfx_w - UI_DW * ui_S) * 0.5);
  ui_oy = 0;                                         // anchor to the top; spare height goes below
  ui_mx = (mouse_x - ui_ox) / ui_S;
  ui_my = (mouse_y - ui_oy) / ui_S;
  ui_alpha = 1;
  ui_last_drag_id = ui_drag_id;
  !(mouse_cap & 1) ? ui_drag_id = 0;               // Round 16 safety net: no drag survives a release
);
function u_px(x) ( floor(ui_ox + x * ui_S + 0.5); );
function u_py(y) ( floor(ui_oy + y * ui_S + 0.5); );
function u_rect(x, y, w, h) local(x0, y0) (
  x0 = u_px(x); y0 = u_py(y);
  gfx_rect(x0, y0, max(1, u_px(x + w) - x0), max(1, u_py(y + h) - y0));
);
function u_tri(x1, y1, x2, y2, x3, y3) (
  gfx_triangle(ui_ox + x1 * ui_S, ui_oy + y1 * ui_S, ui_ox + x2 * ui_S, ui_oy + y2 * ui_S, ui_ox + x3 * ui_S, ui_oy + y3 * ui_S);
);
function u_tw(s) local(w, h) ( gfx_measurestr(s, w, h); w / ui_S; );
function u_th(s) local(w, h) ( gfx_measurestr(s, w, h); h / ui_S; );
function u_text(x, y, s) ( gfx_x = ui_ox + x * ui_S; gfx_y = ui_oy + y * ui_S; gfx_drawstr(s); );
function u_text_r(xr, y, s) ( u_text(xr - u_tw(s), y, s); );
// Carved into the stone (shadow top/left, lit lip bottom/right) and raised stone (the reverse); light from top-left
function u_carve(x, y, w, h) ( c_track(); u_rect(x, y, w, h); c_shade(); u_rect(x, y, w, 1); u_rect(x, y, 1, h);
  c_lip(); u_rect(x, y + h - 1, w, 1); u_rect(x + w - 1, y, 1, h); );
function u_raise(x, y, w, h) ( c_stone(); u_rect(x, y, w, h); c_lip(); u_rect(x, y, w, 1); u_rect(x, y, 1, h);
  c_shade(); u_rect(x, y + h - 1, w, 1); u_rect(x + w - 1, y, 1, h); );
// Letter-spaced text (labels): returns width in design units
function u_tw_sp(s, sp) ( u_tw(s) + sp * max(0, strlen(s) - 1); );
function u_text_sp(x, y, s, sp) local(i, x0) (
  i = 0; x0 = x;
  loop(strlen(s),
    sprintf(#u_ch, "%c", str_getchar(s, i));
    u_text(x, y, #u_ch); x += u_tw(#u_ch) + sp; i += 1;
  );
  x - x0;
);
function u_text_sp_c(cx, cy, s, sp) ( u_text_sp(cx - u_tw_sp(s, sp) * 0.5, cy - u_th(s) * 0.5, s, sp); );
function mouse_in(x, y, w, h) ( ui_mx >= x && ui_mx <= x + w && ui_my >= y && ui_my <= y + h; );
function ui_hit(x, y, w, h) ( ui_mouse_clicked && !ui_dropdown_open && mouse_in(x, y, w, h); );

// ---------- Images ----------
function ui_load_images() (
  !ui_img_tried ? (
    ui_img_tried = 1;
    ui_img_bg = gfx_loadimg(10, 0);       // filename:0 sepulchre_bg.jpg (2408x1000)
    ui_img_ti = gfx_loadimg(11, 1);       // filename:1 sepulchre_titles.png
  );
);
function ui_draw_background() (
  ui_alpha = 1; c_void(); gfx_rect(0, 0, gfx_w, gfx_h);
  ui_img_bg >= 0 ? ( gfx_a = 1; gfx_blit(10, 1, 0, 0, 0, 2408, 1000, ui_ox, ui_oy, UI_DW * ui_S, UI_DH * ui_S); );
);
// Title sprite rows (2x px, 48 px tall): 0..7 names, 8..15 numerals I..VIII, 16 EQUALIZER, 17 IX
function t_name_w(i) ( i == 0 ? 107 : i == 1 ? 214 : i == 2 ? 144 : i == 3 ? 109 : i == 4 ? 130 : i == 5 ? 73 : i == 6 ? 148 : i == 7 ? 140 : 191; );
function t_num_w(i)  ( i == 0 ? 13 : i == 1 ? 23 : i == 2 ? 33 : i == 3 ? 31 : i == 4 ? 21 : i == 5 ? 31 : i == 6 ? 42 : i == 7 ? 52 : 33; );
function ui_sprite(row, w2, x, y) (
  ui_img_ti >= 0 ? ( gfx_a = ui_alpha; gfx_blit(11, 1, 0, 0, row * 48, w2, 48, u_px(x), u_py(y), w2 * 0.5 * ui_S, 24 * ui_S); );
);
// Numeral + name, e.g. "II DISTORTION"; returns right edge
function ui_title(x, y, num_i, name_i) (
  ui_sprite(num_i < 8 ? 8 + num_i : 17, t_num_w(num_i), x, y + 1);
  ui_sprite(name_i < 8 ? name_i : 16, t_name_w(name_i), x + t_num_w(num_i) * 0.5 + 6, y);
  x + t_num_w(num_i) * 0.5 + 6 + t_name_w(name_i) * 0.5;
);

// ---------- Automation ----------
// Bitmask for sliders 1..30; direct sliderN reference for sliders >30 to avoid 32-bit mask overflow (Fixes R2-5)
function auto_slider(id, end_touch) (
  id <= 30 ? slider_automate(2 ^ (id - 1), end_touch) :
  id == 40 ? slider_automate(slider40, end_touch) : id == 41 ? slider_automate(slider41, end_touch) :
  id == 42 ? slider_automate(slider42, end_touch) : id == 43 ? slider_automate(slider43, end_touch) :
  id == 44 ? slider_automate(slider44, end_touch) : id == 45 ? slider_automate(slider45, end_touch) :
  id == 49 ? slider_automate(slider49, end_touch) :
  id == 51 ? slider_automate(slider51, end_touch) : id == 52 ? slider_automate(slider52, end_touch) :
  id == 53 ? slider_automate(slider53, end_touch) :
  id == 54 ? slider_automate(slider54, end_touch) : id == 55 ? slider_automate(slider55, end_touch) :
  id == 56 ? slider_automate(slider56, end_touch) : id == 57 ? slider_automate(slider57, end_touch) :
  id == 58 ? slider_automate(slider58, end_touch) : id == 60 ? slider_automate(slider60, end_touch) :
  id == 37 ? slider_automate(slider37, end_touch) : id == 38 ? slider_automate(slider38, end_touch) :
  id == 39 ? slider_automate(slider39, end_touch) : id == 46 ? slider_automate(slider46, end_touch) :
  id == 47 ? slider_automate(slider47, end_touch) : id == 48 ? slider_automate(slider48, end_touch) :
  id == 59 ? slider_automate(slider59, end_touch) : id == 61 ? slider_automate(slider61, end_touch) :
  id == 62 ? slider_automate(slider62, end_touch) : id == 63 ? slider_automate(slider63, end_touch) :
  id == 64 ? slider_automate(slider64, end_touch) : id == 65 ? slider_automate(slider65, end_touch) :
  id == 66 ? slider_automate(slider66, end_touch) : id == 67 ? slider_automate(slider67, end_touch) :
  id == 68 ? slider_automate(slider68, end_touch) : id == 69 ? slider_automate(slider69, end_touch) :
  id == 70 ? slider_automate(slider70, end_touch) : id == 71 ? slider_automate(slider71, end_touch) :
  id == 72 ? slider_automate(slider72, end_touch) : id == 73 ? slider_automate(slider73, end_touch) :
  id == 75 ? slider_automate(slider75, end_touch) : id == 76 ? slider_automate(slider76, end_touch) :
  id == 77 ? slider_automate(slider77, end_touch) : id == 78 ? slider_automate(slider78, end_touch);
);
function set_param(id, v) (
  slider(id) = v; sl_snap[id] = v; auto_slider(id, 1);
  mark_slider_dirty(id); preset_dirty = 1;
);
// ---------- Widgets ----------
// Round 64: flat, minimal controls. Choice button = text only; selected = bone text + bone underline,
// unselected = grey text + faint hairline. No boxes, bevels or fills.
function ui_seg(x, y, w, h, label, sel) local(hit, hov) (
  hit = ui_hit(x, y, w, h); hov = mouse_in(x, y, w, h) && !ui_dropdown_open;
  sel ? ( c_bone(); u_rect(x + 2, y + h - 2, w - 4, 2); ) : ( c_border(); u_rect(x + 2, y + h - 1, w - 4, 1); );
  f_label(); sel ? c_bone() : hov ? c_lab() : c_soft();
  u_text_sp_c(x + w * 0.5, y + h * 0.5 - 1, label, 1);
  hit;
);
// Toggle: same style; engaged = bone text + amber underline
function ui_toggle(x, y, w, h, label, on) local(hit, hov) (
  hit = ui_hit(x, y, w, h); hov = mouse_in(x, y, w, h) && !ui_dropdown_open;
  on ? ( c_ember(); u_rect(x + 2, y + h - 2, w - 4, 2); ) : ( c_border(); u_rect(x + 2, y + h - 1, w - 4, 1); );
  f_label(); on ? c_bone() : hov ? c_lab() : c_soft();
  u_text_sp_c(x + w * 0.5, y + h * 0.5 - 1, label, 1.5);
  hit;
);
// Power lamp: a plain dot. Lit = amber, off = dark grey. Returns 1 when clicked.
function ui_power_led(x, y, on) local(hit, a0) (
  hit = ui_hit(x - 5, y - 5, 21, 21);
  a0 = ui_alpha; ui_alpha = 1;
  on ? c_ember() : c_border();
  gfx_circle(ui_ox + (x + 5.5) * ui_S, ui_oy + (y + 5.5) * ui_S, 3 * ui_S, 1, 1);
  ui_alpha = a0;
  hit;
);

// Horizontal slider (30 tall). bip_k > 0: shows (val - centre) * bip_k, filled from the centre detent.
// bip_k == -1: Metal Zone MID FREQ, shown as 300 Hz..4 kHz (log sweep of a 0..10 knob).
function ui_hslider(id, x, y, w, label, val, min_v, max_v, dflt_v, step_v, fmt, bip_k)
  local(ty, norm, new_val, d_norm, now_t, cx, fx) (
  f_label(); c_lab(); u_text_sp(x, y + 1, label, 1.6);
  f_value(); c_bone();
  bip_k > 0 ? sprintf(#val_str, fmt, (val - (min_v + max_v) * 0.5) * bip_k)
  : bip_k < 0 ? sprintf(#val_str, fmt, 300 * (4000 / 300) ^ (val * 0.1)) : sprintf(#val_str, fmt, val);
  u_text_r(x + w, y, #val_str);

  ty = y + 21; new_val = val;
  ui_last_drag_id == id && !(mouse_cap & 1) ? auto_slider(id, 1);   // drag just released: end automation touch
  ui_hit(x - 3, y + 13, w + 6, 16) ? (
    time_precise(now_t);
    (ui_last_click_id == id && (now_t - ui_last_click_t) < 0.32) ? (
      new_val = dflt_v; set_param(id, new_val); ui_drag_id = 0; ui_last_click_id = 0;   // double-click: default
    ) : (
      ui_drag_id = id; ui_drag_start_x = ui_mx; ui_drag_start_v = val;
      ui_last_click_id = id; ui_last_click_t = now_t;
    );
  );
  !ui_dropdown_open && mouse_wheel != 0 && mouse_in(x, y, w, 30) ? (
    new_val = clamp(val + (mouse_wheel > 0 ? 1 : -1) * max(step_v, (max_v - min_v) * 0.01), min_v, max_v);
    mouse_wheel = 0;
    new_val != val ? set_param(id, new_val);
  );
  ui_drag_id == id && (mouse_cap & 1) ? (
    (mouse_cap & 8) ? (                                  // Shift: fine relative drag
      d_norm = (ui_mx - ui_drag_start_x) / (w * 5.0);
      new_val = ui_drag_start_v + d_norm * (max_v - min_v);
      ui_drag_start_x = ui_mx; ui_drag_start_v = new_val;
    ) : ( new_val = min_v + clamp((ui_mx - x) / w, 0, 1) * (max_v - min_v); );
    step_v > 0 ? new_val = floor(new_val / step_v + 0.5) * step_v;
    new_val = clamp(new_val, min_v, max_v);
    new_val != val ? ( slider(id) = new_val; sl_snap[id] = new_val; auto_slider(id, 0); mark_slider_dirty(id); preset_dirty = 1; );
  );

  norm = clamp((new_val - min_v) / (max_v - min_v), 0, 1);
  fx = x + norm * w;
  u_carve(x, ty - 1, w, 5);                                       // Round 60: groove chiselled into the stone
  bip_k > 0 ? (
    cx = x + w * 0.5;
    c_fill(); u_rect(min(cx, fx), ty, max(1, abs(fx - cx)), 3);
    c_det(); u_rect(cx - 0.5, ty - 4, 1, 11);
  ) : ( c_fill(); u_rect(x + 1, ty, max(0, fx - x - 1), 3); );
  c_shade(); u_rect(fx - 1.5, ty - 5, 5, 15); c_thumb(); u_rect(fx - 2.5, ty - 6, 5, 15);   // bone chip + shadow
  new_val;
);

function m_x(db, x, w) ( x + w * clamp((db + 60) / 60, 0, 1); );
function m_tick(t, x, w, y, s) ( u_text(m_x(t, x, w) - u_tw(s) * 0.5, y, s); );
// Peak meter (40 tall): -60..0 dBFS, optional gate threshold marker and target band (Round 55: target < 0 = band
// from target to target + 12 dB, e.g. -18 = the INPUT zone the presets are tuned for)
function ui_meter(x, y, w, label, peak_lin, thr_db, target) local(db, by, tx) (
  db = peak_lin > 0.00003 ? 20 * log10(peak_lin) : -90;
  f_label(); c_lab(); u_text_sp(x, y + 1, label, 1.6);
  f_value(); c_bone();
  db > -80 ? sprintf(#m_str, "%+.1f", db) : strcpy(#m_str, "-INF");
  u_text_r(x + w, y, #m_str);
  by = y + 20;
  u_carve(x, by, w, 8);
  target < 0 ? ( ui_alpha *= 0.3; c_ember(); u_rect(m_x(target, x, w), by + 1, m_x(target + 12, x, w) - m_x(target, x, w), 6); ui_alpha /= 0.3; );
  db > -60 ? ( db > -1 ? u_rgb(200, 44, 30) : c_bone(); u_rect(x + 1, by + 2, m_x(db, x, w) - x - 1, 4); );
  thr_db > -100 ? ( tx = m_x(thr_db, x, w); c_ember(); u_rect(tx - 1, by - 5, 2, 18); );
  f_tiny(); c_tick();
  m_tick(-48, x, w, by + 10, "-48"); m_tick(-24, x, w, by + 10, "-24"); m_tick(-12, x, w, by + 10, "-12");
  m_tick(-6, x, w, by + 10, "-6"); m_tick(0, x, w, by + 10, "0");
);

// ---------- Global preset selector ----------
// Round 55: < > step buttons left of the bar (each h x h), then the dropdown bar
function draw_preset_dropdown_bar(x, y, w, h) local(n) (
  ui_alpha = 1; n = clamp(floor(slider60 + 0.5), 0, GP_COUNT - 1);
  f_small(); c_lab(); u_text_sp(x, y - 16, "PRESET", 2);
  ui_seg(x, y, h, h, "<", 0) ? ( recall_global_preset(n > 0 ? n - 1 : GP_COUNT - 1); auto_slider(60, 1); sliderchange(-1); ui_dropdown_open = 0; );
  ui_seg(x + h + 3, y, h, h, ">", 0) ? ( recall_global_preset(n < GP_COUNT - 1 ? n + 1 : 0); auto_slider(60, 1); sliderchange(-1); ui_dropdown_open = 0; );
  x += 2 * h + 6; w -= 2 * h + 6;
  u_carve(x, y, w, h);
  n = floor(slider60 + 0.5);
  f_value(); c_bone(); u_text(x + 12, y + (h - u_th("0")) * 0.5, get_global_preset_name(n));
  preset_dirty ? ( c_ember(); u_text(x + 18 + u_tw(get_global_preset_name(n)), y + (h - u_th("0")) * 0.5, "*"); );
  c_fill(); u_tri(x + w - 20, y + h * 0.5 - 2, x + w - 10, y + h * 0.5 - 2, x + w - 15, y + h * 0.5 + 3);
  ui_mouse_clicked && mouse_in(x, y, w, h) ? ( ui_dropdown_open = !ui_dropdown_open; ui_mouse_clicked = 0; );
);
function draw_preset_dropdown_menu(x, y, w, row_h) local(i, ry, hovered, cur) (
  ui_dropdown_open ? (
    ui_alpha = 1; cur = floor(slider60 + 0.5);
    u_raise(x, y, w, GP_COUNT * row_h); ui_alpha = 0.75; c_void(); u_rect(x + 1, y + 1, w - 2, GP_COUNT * row_h - 2); ui_alpha = 1;
    i = 0;
    loop(GP_COUNT,
      ry = y + i * row_h; hovered = mouse_in(x, ry, w, row_h);
      hovered ? ( u_rgb(30, 29, 28); u_rect(x + 1, ry + 1, w - 2, row_h - 2); );
      i == cur ? ( c_ember(); u_rect(x + 1, ry + 4, 3, row_h - 8); );
      f_value(); (i == cur || hovered) ? c_bone() : c_soft();
      u_text(x + 14, ry + (row_h - u_th("0")) * 0.5, get_global_preset_name(i));
      ui_mouse_clicked && hovered ? ( recall_global_preset(i); auto_slider(60, 1); sliderchange(-1); ui_dropdown_open = 0; ui_mouse_clicked = 0; );
      i += 1;
    );
    ui_mouse_clicked ? ( ui_dropdown_open = 0; ui_mouse_clicked = 0; );
  );
);
