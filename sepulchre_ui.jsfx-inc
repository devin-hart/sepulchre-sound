// sepulchre_ui.jsfx-inc
// Necro-monochrome theme, resolution-independent drawing primitives, and widgets
// (horizontal sliders with bipolar dB mode, segment/toggle buttons, meters, LED, preset dropdown).
// All widget coordinates are in a fixed design space (UI_DW x UI_DH) scaled to the window by ui_begin().
@init

UI_DW = 1204; UI_DH = 500;
gfx_ext_retina = 1;

// ---------- Theme: near-black + bone/ash; blood only for "engaged", bright red only for clip ----------
function u_rgb(r, g, b) ( gfx_r = r / 255; gfx_g = g / 255; gfx_b = b / 255; gfx_a = ui_alpha; );
function c_void()  ( u_rgb(9, 9, 9); );        // #090909 window
function c_panel() ( u_rgb(17, 17, 17); );     // #111111 panel body
function c_head()  ( u_rgb(24, 24, 24); );     // #181818 panel header / hover
function c_track() ( u_rgb(36, 36, 36); );     // #242424 slider/meter track
function c_rule()  ( u_rgb(70, 70, 70); );     // #464646 borders, dividers
function c_ash()   ( u_rgb(160, 156, 148); );  // #A09C94 labels
function c_bone()  ( u_rgb(232, 227, 215); );  // #E8E3D7 values, selected
function c_blood() ( u_rgb(132, 18, 22); );    // #841216 engaged toggles
function c_clip()  ( u_rgb(218, 40, 40); );    // #DA2828 clip / over

function f_label() ( gfx_setfont(1, "Arial", 11 * ui_S, 'b'); );
function f_value() ( gfx_setfont(2, "Consolas", 12 * ui_S); );
function f_title() ( gfx_setfont(3, "Times New Roman", 16 * ui_S, 'b'); );
function f_logo()  ( gfx_setfont(4, "Times New Roman", 36 * ui_S, 'b'); );
function f_small() ( gfx_setfont(5, "Arial", 9 * ui_S); );

// ---------- Scaling ----------
function ui_begin() (
  ui_S = max(0.5, min(gfx_w / UI_DW, gfx_h / UI_DH));
  ui_ox = floor((gfx_w - UI_DW * ui_S) * 0.5);
  ui_oy = floor((gfx_h - UI_DH * ui_S) * 0.5);
  ui_mx = (mouse_x - ui_ox) / ui_S;
  ui_my = (mouse_y - ui_oy) / ui_S;
  ui_alpha = 1;
);

function u_px(x) ( floor(ui_ox + x * ui_S + 0.5); );
function u_py(y) ( floor(ui_oy + y * ui_S + 0.5); );
function u_rect(x, y, w, h) local(x0, y0) (
  x0 = u_px(x); y0 = u_py(y);
  gfx_rect(x0, y0, max(1, u_px(x + w) - x0), max(1, u_py(y + h) - y0));
);
function u_frame(x, y, w, h) local(x0, y0, x1, y1) (
  x0 = u_px(x); y0 = u_py(y); x1 = u_px(x + w) - 1; y1 = u_py(y + h) - 1;
  gfx_line(x0, y0, x1, y0, 0); gfx_line(x1, y0, x1, y1, 0);
  gfx_line(x1, y1, x0, y1, 0); gfx_line(x0, y1, x0, y0, 0);
);
function u_tri(x1, y1, x2, y2, x3, y3) (
  gfx_triangle(ui_ox + x1 * ui_S, ui_oy + y1 * ui_S, ui_ox + x2 * ui_S, ui_oy + y2 * ui_S, ui_ox + x3 * ui_S, ui_oy + y3 * ui_S);
);
function u_tw(s) local(w, h) ( gfx_measurestr(s, w, h); w / ui_S; );
function u_text(x, y, s) ( gfx_x = ui_ox + x * ui_S; gfx_y = ui_oy + y * ui_S; gfx_drawstr(s); );
function u_text_r(xr, y, s) ( u_text(xr - u_tw(s), y, s); );
function u_text_cc(cx, cy, s) local(w, h) (
  gfx_measurestr(s, w, h);
  gfx_x = ui_ox + cx * ui_S - w * 0.5; gfx_y = ui_oy + cy * ui_S - h * 0.5;
  gfx_drawstr(s);
);
function mouse_in(x, y, w, h) ( ui_mx >= x && ui_mx <= x + w && ui_my >= y && ui_my <= y + h; );
function ui_hit(x, y, w, h) ( ui_mouse_clicked && !ui_dropdown_open && mouse_in(x, y, w, h); );

// Static film grain (deterministic positions, so it doesn't flicker)
function ui_grain() local(i, gx, gy) (
  ui_alpha = 0.6; u_rgb(28, 28, 28);
  i = 0;
  loop(900,
    gx = sin(i * 12.9898) * 43758.5453; gx -= floor(gx);
    gy = sin(i * 78.233) * 12543.1459; gy -= floor(gy);
    gfx_rect(floor(gx * gfx_w), floor(gy * gfx_h), 1, 1);
    i += 1;
  );
  ui_alpha = 1;
);

// ---------- Automation ----------
// Bitmask for sliders 1..30; direct sliderN reference for sliders >30 to avoid 32-bit mask overflow (Fixes R2-5)
function auto_slider(id, end_touch) (
  id <= 30 ? slider_automate(2 ^ (id - 1), end_touch) :
  id == 31 ? slider_automate(slider31, end_touch) : id == 32 ? slider_automate(slider32, end_touch) :
  id == 33 ? slider_automate(slider33, end_touch) : id == 34 ? slider_automate(slider34, end_touch) :
  id == 35 ? slider_automate(slider35, end_touch) : id == 36 ? slider_automate(slider36, end_touch) :
  id == 40 ? slider_automate(slider40, end_touch) : id == 41 ? slider_automate(slider41, end_touch) :
  id == 42 ? slider_automate(slider42, end_touch) : id == 43 ? slider_automate(slider43, end_touch) :
  id == 44 ? slider_automate(slider44, end_touch) : id == 45 ? slider_automate(slider45, end_touch) :
  id == 49 ? slider_automate(slider49, end_touch) :
  id == 50 ? slider_automate(slider50, end_touch) : id == 51 ? slider_automate(slider51, end_touch) :
  id == 52 ? slider_automate(slider52, end_touch) : id == 53 ? slider_automate(slider53, end_touch) :
  id == 54 ? slider_automate(slider54, end_touch) : id == 55 ? slider_automate(slider55, end_touch) :
  id == 56 ? slider_automate(slider56, end_touch) : id == 57 ? slider_automate(slider57, end_touch) :
  id == 58 ? slider_automate(slider58, end_touch) : id == 60 ? slider_automate(slider60, end_touch);
);

// Write a parameter from the UI: value, host notification, DSP resync, preset-modified flag, IR reload
function set_param(id, v) (
  slider(id) = v;
  auto_slider(id, 1);
  ui_need_sync = 1; preset_dirty = 1;
  (id == 52 || id == 53) && slider52 > 0.5 ? ir_reload_req = 1;
);

function swap_routing_slots(slot_a, slot_b) local(tmp) (
  slot_a == 0 && slot_b == 1 ? ( tmp = slider5; slider5 = slider6; slider6 = tmp; auto_slider(5, 1); auto_slider(6, 1); );
  slot_a == 1 && slot_b == 2 ? ( tmp = slider6; slider6 = slider7; slider7 = tmp; auto_slider(6, 1); auto_slider(7, 1); );
  slot_a == 2 && slot_b == 3 ? ( tmp = slider7; slider7 = slider8; slider8 = tmp; auto_slider(7, 1); auto_slider(8, 1); );
  ui_need_sync = 1; preset_dirty = 1;
);

// ---------- Widgets ----------
// Choice/segment button: selected = bone text on raised fill with bone underline
function ui_seg(x, y, w, h, label, sel) local(hit) (
  hit = ui_hit(x, y, w, h);
  sel ? ( c_track(); u_rect(x, y, w, h); c_bone(); u_rect(x, y + h - 2, w, 2); )
      : ( mouse_in(x, y, w, h) && !ui_dropdown_open ? ( c_head(); u_rect(x, y, w, h); ); c_rule(); u_frame(x, y, w, h); );
  f_label(); sel ? c_bone() : c_ash();
  u_text_cc(x + w * 0.5, y + h * 0.5, label);
  hit;
);

// Engaged toggle: blood fill when on
function ui_toggle(x, y, w, h, label, on) local(hit) (
  hit = ui_hit(x, y, w, h);
  on ? ( c_blood(); u_rect(x, y, w, h); ) : ( c_rule(); u_frame(x, y, w, h); );
  f_label(); on ? c_bone() : c_ash();
  u_text_cc(x + w * 0.5, y + h * 0.5, label);
  hit;
);

// Horizontal slider. bip_k > 0: value shown as (val - 50) * bip_k (e.g. dB) and filled from the centre detent.
function ui_hslider(id, x, y, w, label, val, min_v, max_v, dflt_v, step_v, fmt, bip_k)
  local(track_y, norm, new_val, d_norm, now_t, cx, fx) (
  f_label(); c_ash(); u_text(x, y, label);
  f_value(); c_bone();
  bip_k > 0 ? sprintf(#val_str, fmt, (val - 50) * bip_k) : sprintf(#val_str, fmt, val);
  u_text_r(x + w, y - 1, #val_str);

  track_y = y + 18;
  new_val = val;
  ui_hit(x - 3, y + 11, w + 6, 16) ? (
    time_precise(now_t);
    (ui_last_click_id == id && (now_t - ui_last_click_t) < 0.32) ? (
      new_val = dflt_v; set_param(id, new_val);      // double-click: reset to default
      ui_drag_id = 0; ui_last_click_id = 0;
    ) : (
      ui_drag_id = id; ui_drag_start_x = ui_mx; ui_drag_start_v = val;
      ui_last_click_id = id; ui_last_click_t = now_t;
    );
  );
  !ui_dropdown_open && mouse_wheel != 0 && mouse_in(x, y, w, 28) ? (
    new_val = clamp(val + (mouse_wheel > 0 ? 1 : -1) * max(step_v, (max_v - min_v) * 0.01), min_v, max_v);
    mouse_wheel = 0;
    new_val != val ? set_param(id, new_val);
  );
  ui_drag_id == id && (mouse_cap & 1) ? (
    (mouse_cap & 8) ? (                                // Shift: fine relative drag
      d_norm = (ui_mx - ui_drag_start_x) / (w * 5.0);
      new_val = ui_drag_start_v + d_norm * (max_v - min_v);
      ui_drag_start_x = ui_mx; ui_drag_start_v = new_val;
    ) : (
      new_val = min_v + clamp((ui_mx - x) / w, 0, 1) * (max_v - min_v);
    );
    step_v > 0 ? new_val = floor(new_val / step_v + 0.5) * step_v;
    new_val = clamp(new_val, min_v, max_v);
    new_val != val ? ( slider(id) = new_val; auto_slider(id, 0); ui_need_sync = 1; preset_dirty = 1; );
  );

  norm = clamp((new_val - min_v) / (max_v - min_v), 0, 1);
  fx = x + norm * w;
  c_track(); u_rect(x, track_y, w, 4);
  bip_k > 0 ? (
    cx = x + w * (50 - min_v) / (max_v - min_v);
    c_ash(); u_rect(min(cx, fx), track_y, max(1, abs(fx - cx)), 4);
    c_rule(); u_rect(cx - 0.5, track_y - 3, 1, 10);
  ) : (
    c_ash(); u_rect(x, track_y, max(0, fx - x), 4);
  );
  c_bone(); u_rect(fx - 1.5, track_y - 4, 3, 12);
  new_val;
);

function m_db_x(db, x, w) ( x + w * clamp((db + 60) / 60, 0, 1); );
function m_tick(t, x, w, y, s) ( u_rect(m_db_x(t, x, w) - 0.5, y, 1, 3); u_text_cc(m_db_x(t, x, w), y + 9, s); );

// Peak meter, -60..0 dBFS, with optional gate threshold marker and -10..-8 dBFS target band
function ui_meter(x, y, w, label, peak_lin, thr_db, target) local(db, fx, tx) (
  db = peak_lin > 0.00003 ? 20 * log10(peak_lin) : -90;
  f_label(); c_ash(); u_text(x, y, label);
  f_value(); c_bone();
  db > -80 ? sprintf(#m_str, "%+.1f", db) : strcpy(#m_str, "-INF");
  u_text_r(x + w, y - 1, #m_str);
  y += 17;
  c_track(); u_rect(x, y, w, 9);
  target ? ( u_rgb(74, 20, 22); u_rect(m_db_x(-10, x, w), y, m_db_x(-8, x, w) - m_db_x(-10, x, w), 9); );
  fx = m_db_x(db, x, w);
  fx > x ? ( db > -1 ? c_clip() : c_bone(); u_rect(x, y + 2, fx - x, 5); );
  thr_db > -100 ? (
    tx = m_db_x(thr_db, x, w);
    c_blood(); u_rect(tx - 1, y - 3, 2, 15);
    u_tri(tx - 4, y - 8, tx + 4, y - 8, tx, y - 3);
  );
  f_small(); c_ash();
  m_tick(-48, x, w, y + 11, "-48"); m_tick(-24, x, w, y + 11, "-24"); m_tick(-12, x, w, y + 11, "-12");
  m_tick(-6, x, w, y + 11, "-6"); m_tick(0, x, w, y + 11, "0");
);

function ui_led(x, y, on, label) (
  on ? c_bone() : c_blood(); u_rect(x, y, 7, 7);
  f_small(); c_ash(); u_text(x + 12, y - 2, label);
);

// ---------- Global preset dropdown ----------
function draw_preset_dropdown_bar(x, y, w, h) (
  c_track(); u_rect(x, y, w, h);
  c_rule(); u_frame(x, y, w, h);
  strcpy(#dd_lbl, get_global_preset_name(slider60));
  preset_dirty ? strcat(#dd_lbl, "  *");
  f_value(); c_bone(); u_text(x + 10, y + (h - 13) * 0.5, #dd_lbl);
  c_ash(); u_tri(x + w - 18, y + h * 0.5 - 2, x + w - 8, y + h * 0.5 - 2, x + w - 13, y + h * 0.5 + 3);
  ui_mouse_clicked && mouse_in(x, y, w, h) ? ( ui_dropdown_open = !ui_dropdown_open; ui_mouse_clicked = 0; );
);

function draw_preset_dropdown_menu(x, y, w, row_h) local(i, ry, hovered) (
  ui_dropdown_open ? (
    ui_alpha = 1;
    c_panel(); u_rect(x, y, w, 7 * row_h);
    c_rule(); u_frame(x, y, w, 7 * row_h);
    i = 0;
    loop(7,
      ry = y + i * row_h;
      hovered = mouse_in(x, ry, w, row_h);
      hovered ? ( c_head(); u_rect(x + 1, ry + 1, w - 2, row_h - 2); );
      i == slider60 ? ( c_blood(); u_rect(x + 1, ry + 1, 3, row_h - 2); );
      f_value(); (i == slider60 || hovered) ? c_bone() : c_ash();
      u_text(x + 12, ry + (row_h - 13) * 0.5, get_global_preset_name(i));
      ui_mouse_clicked && hovered ? (
        recall_global_preset(i); auto_slider(60, 1);
        ui_dropdown_open = 0; ui_mouse_clicked = 0;
      );
      i += 1;
    );
    ui_mouse_clicked ? ( ui_dropdown_open = 0; ui_mouse_clicked = 0; );
  );
);
