// sepulchre_dsp_fx.jsfx-inc
// Buffer-based modulation & spatial effects in the amp's FX loop: CE-2 Chorus (Mod 2) and Reverb (Mod 4). Delay removed in Round 43
@init

function buf_read_interp(buf, len, wpos, delay_spl) local(rpos, idx0, idx1, frac) (
  rpos = wpos - delay_spl;
  while (rpos < 0) ( rpos += len; );
  while (rpos >= len) ( rpos -= len; );
  idx0 = floor(rpos);
  idx1 = idx0 + 1;
  idx1 >= len ? idx1 = 0;
  frac = rpos - idx0;
  buf[idx0] * (1.0 - frac) + buf[idx1] * frac;
);

function fdn_read(buf, len, wpos, d_spl) (
  buf_read_interp(buf, len, wpos, clamp(d_spl, 2.0, len - 4.0));
);

function fdn_write(buf, len, idx_ptr, x) local(idx) (
  idx = idx_ptr[0]; idx >= len ? idx = 0;
  buf[idx] = x;
  idx += 1; idx >= len ? idx = 0;
  idx_ptr[0] = idx;
);

function allpass_proc(buf, len, idx_ptr, x, g) local(idx, buf_out, y) (
  idx = idx_ptr[0]; idx >= len ? idx = 0;
  buf_out = buf[idx];
  y = -g * x + buf_out;
  buf[idx] = x + g * buf_out;
  idx += 1;
  idx >= len ? idx = 0;
  idx_ptr[0] = idx;
  y;
);

function rt60_fb(comb_len, decay_s) (
  clamp(exp(-6.907755 * comb_len / (srate * max(0.2, decay_s))), 0.15, 0.9992);
);

function init_fx_dsp() (
  // Chorus buffers (~170 ms at 48 kHz)
  chorus_len = 8192;
  chorus_buf_l = alloc_buf(chorus_len);
  chorus_buf_r = alloc_buf(chorus_len);
  chorus_wpos = 0;
  chorus_phase = 0.0;
  bq_chorus_lp = alloc_buf(9);                      // CE-2 reconstruction filter (2nd-order part)
  bq_chorus_aa = alloc_buf(9);                      // CE-2 anti-alias filter (2nd-order part)

  // Reverb buffers: Pre-delay + 4x4 Hadamard FDN delay lines + 2 series input diffusers
  rev_pre_len = 16384;
  rev_pre_l = alloc_buf(rev_pre_len);
  rev_pre_r = alloc_buf(rev_pre_len);
  rev_pre_wpos = 0;

  comb_max = 12288;
  comb_l1 = alloc_buf(comb_max); comb_l2 = alloc_buf(comb_max);
  comb_l3 = alloc_buf(comb_max); comb_l4 = alloc_buf(comb_max);
  comb_r1 = alloc_buf(comb_max); comb_r2 = alloc_buf(comb_max);
  comb_r3 = alloc_buf(comb_max); comb_r4 = alloc_buf(comb_max);

  ap_max = 4096;
  ap_l1 = alloc_buf(ap_max); ap_l2 = alloc_buf(ap_max);
  ap_r1 = alloc_buf(ap_max); ap_r2 = alloc_buf(ap_max);

  rev_state = alloc_buf(32);
  bq_rev_shelf = alloc_buf(9);
  rev_en_s = 0.0; rev_idle_max = 4800; rev_mod_ph = 0.0;
);

function reset_fx_state() (
  memset(chorus_buf_l, 0, chorus_len); memset(chorus_buf_r, 0, chorus_len);
  memset(rev_pre_l, 0, rev_pre_len);   memset(rev_pre_r, 0, rev_pre_len);
  memset(comb_l1, 0, comb_max); memset(comb_l2, 0, comb_max);
  memset(comb_l3, 0, comb_max); memset(comb_l4, 0, comb_max);
  memset(comb_r1, 0, comb_max); memset(comb_r2, 0, comb_max);
  memset(comb_r3, 0, comb_max); memset(comb_r4, 0, comb_max);
  memset(ap_l1, 0, ap_max);     memset(ap_l2, 0, ap_max);
  memset(ap_r1, 0, ap_max);     memset(ap_r2, 0, ap_max);
  memset(rev_state, 0, 32);
  bq_clear(bq_chorus_lp); bq_clear(bq_chorus_aa); bq_clear(bq_rev_shelf);
  chorus_wpos = 0; chorus_phase = 0.0;
  ch_hp_xl = 0; ch_hp_yl = 0; ch_hp_xr = 0; ch_hp_yr = 0; ch_a1l = 0; ch_a1r = 0; ch_r1l = 0; ch_r1r = 0;
  rev_pre_wpos = 0; rev_mod_ph = 0.0;
  reverb_mix_s = reverb_mix_t; rev_en_s = slider40 > 0.5 ? 1.0 : 0.0; rev_idle = 0;
);

function update_fx_coeffs() local(rev_fc, s_scale, mode_scale, eff_decay, d48) (
  // Round 42: Boss CE-2 (ElectroSmash analysis). Wet path: 48 Hz HPF -> 3rd-order anti-alias LPF (6.6 kHz pole +
  // 6.9 kHz pair) -> MN3007 BBD delay swept by a triangle LFO -> same 3rd-order reconstruction LPF. Dry + wet summed
  // with equal resistors (50/50); x0.78 keeps the engaged RMS level within 0.1 dB of bypass on a guitar DI. Pre/de-emphasis cancel (no BBD noise modelled).
  bq_lp(bq_chorus_aa, 6900.0, 0.7071); bq_lp(bq_chorus_lp, 6900.0, 0.7071);
  ch_a66 = exp(-2 * $pi * 6600 / srate); ch_a48 = exp(-2 * $pi * 48 / srate);
  ch_rate = 0.1 * 35 ^ (slider77 * 0.1);                       // Rate knob: 0.1 .. 3.5 Hz (pedal max 3.5 Hz)
  ch_dmin = 0.003 * srate;                                      // BBD delay: 3 ms ..
  ch_dsw = (0.0003 + 0.0047 * slider78 * 0.1) * srate;          //   + 0.3 .. 5 ms sweep (Depth knob)

  // Round 69 (SOUND_REFERENCES §7-D): Diffused modulated 4x4 Hadamard FDN tank (replaces metallic Schroeder combs)
  rev_mode = floor(slider41 + 0.5);
  s_scale = srate / 44100.0;
  mode_scale = rev_mode == 1 ? 0.62 : (rev_mode == 2 ? 1.32 : 1.0);
  c_len_l1 = min(comb_max - 32, floor(1559 * s_scale * mode_scale));
  c_len_l2 = min(comb_max - 32, floor(1871 * s_scale * mode_scale));
  c_len_l3 = min(comb_max - 32, floor(2207 * s_scale * mode_scale));
  c_len_l4 = min(comb_max - 32, floor(2593 * s_scale * mode_scale));
  c_len_r1 = min(comb_max - 32, floor(1619 * s_scale * mode_scale));
  c_len_r2 = min(comb_max - 32, floor(1933 * s_scale * mode_scale));
  c_len_r3 = min(comb_max - 32, floor(2269 * s_scale * mode_scale));
  c_len_r4 = min(comb_max - 32, floor(2657 * s_scale * mode_scale));

  ap_len_l1 = min(ap_max - 4, floor(149 * s_scale));
  ap_len_l2 = min(ap_max - 4, floor(383 * s_scale));
  ap_len_r1 = min(ap_max - 4, floor(163 * s_scale));
  ap_len_r2 = min(ap_max - 4, floor(409 * s_scale));

  // Calibrated RT60 feedback per FDN line (orthogonal 0.5*H4 preserves exact RT60 energy)
  eff_decay = slider42 * (rev_mode == 2 ? 1.25 : 1.0);
  c_fb_l1 = rt60_fb(c_len_l1, eff_decay); c_fb_l2 = rt60_fb(c_len_l2, eff_decay);
  c_fb_l3 = rt60_fb(c_len_l3, eff_decay); c_fb_l4 = rt60_fb(c_len_l4, eff_decay);
  c_fb_r1 = rt60_fb(c_len_r1, eff_decay); c_fb_r2 = rt60_fb(c_len_r2, eff_decay);
  c_fb_r3 = rt60_fb(c_len_r3, eff_decay); c_fb_r4 = rt60_fb(c_len_r4, eff_decay);

  // Round 67: 48 kHz-anchored exponential srate scaling keeps cutoff constant across sample rates without changing 48k
  d48 = clamp((slider44 * 0.0070 + (rev_mode == 0 ? 0.16 : 0.05)) * (44100.0 / 48000.0), 0.03, 0.85);
  rev_damp = d48 ^ (48000.0 / srate);
  rev_ap_g = rev_mode == 1 ? 0.65 : 0.58;
  rev_mod_inc = 2.0 * $pi * (rev_mode == 2 ? 0.55 : 0.72) / srate;
  rev_mod_d = (rev_mode == 1 ? 5.0 : 8.5) * s_scale;
  rev_fc = 1200.0 + (1.0 - slider44 * 0.01) * 6500.0;
  bq_hshelf(bq_rev_shelf, rev_fc, -3.0 - (slider44 * 0.12));
  reverb_mix_t = slider45 * 0.01;
  rev_idle_max = floor(0.1 * srate);
);

// Boss CE-2 chorus. Bypass crossfades over ~20 ms; buffer keeps running so engaging it is click-free.
function proc_chorus() local(tri, d, x, wl, wr) (
  chorus_mix_s = param_smooth_c * chorus_mix_s + (1.0 - param_smooth_c) * (slider20 > 0.5 ? 1.0 : 0.0);
  chorus_phase += ch_rate / srate; chorus_phase >= 1.0 ? chorus_phase -= 1.0;
  tri = 1.0 - 2.0 * abs(2.0 * chorus_phase - 1.0);             // triangle -1..1 (CE-2 TL022 integrator)
  d = ch_dmin + ch_dsw * (tri + 1.0) * 0.5;
  // wet input: 48 Hz HPF -> 6.6 kHz 1-pole -> 6.9 kHz biquad, written into the BBD line
  x = spl0; ch_hp_yl = ch_a48 * (ch_hp_yl + x - ch_hp_xl); ch_hp_xl = x;
  ch_a1l = ch_hp_yl + ch_a66 * (ch_a1l - ch_hp_yl); chorus_buf_l[chorus_wpos] = bq_proc_l(bq_chorus_aa, ch_a1l);
  x = spl1; ch_hp_yr = ch_a48 * (ch_hp_yr + x - ch_hp_xr); ch_hp_xr = x;
  ch_a1r = ch_hp_yr + ch_a66 * (ch_a1r - ch_hp_yr); chorus_buf_r[chorus_wpos] = bq_proc_r(bq_chorus_aa, ch_a1r);
  wl = buf_read_interp(chorus_buf_l, chorus_len, chorus_wpos, d);
  wr = buf_read_interp(chorus_buf_r, chorus_len, chorus_wpos, d);
  chorus_wpos += 1; chorus_wpos >= chorus_len ? chorus_wpos = 0;
  ch_r1l = wl + ch_a66 * (ch_r1l - wl); wl = bq_proc_l(bq_chorus_lp, ch_r1l);   // reconstruction filter
  ch_r1r = wr + ch_a66 * (ch_r1r - wr); wr = bq_proc_r(bq_chorus_lp, ch_r1r);
  spl0 += chorus_mix_s * ((spl0 + wl) * 0.78 - spl0);
  spl1 += chorus_mix_s * ((spl1 + wr) * 0.78 - spl1);
);

// Diffused modulated 4x4 Hadamard FDN reverb with bypass spillover and -120 dB idle gate
function proc_reverb() local(en, pre_spl, in_l, in_r, m1, m2, y0, y1, y2, y3, yr0, yr1, yr2, yr3, a, b, c, d, sum_l, sum_r, cross_l, cross_r) (
  en = slider40 > 0.5;
  rev_en_s = param_smooth_c * rev_en_s + (1.0 - param_smooth_c) * (en ? 1.0 : 0.0);
  en || rev_en_s > 0.0001 ? rev_idle = 0;
  rev_idle < rev_idle_max ? (
  reverb_mix_s = param_smooth_c * reverb_mix_s + (1.0 - param_smooth_c) * reverb_mix_t;

  pre_spl = clamp(slider43 * 0.001 * srate, 1.0, rev_pre_len - 16.0);
  rev_pre_l[rev_pre_wpos] = en ? spl0 : 0.0;
  rev_pre_r[rev_pre_wpos] = en ? spl1 : 0.0;
  in_l = buf_read_interp(rev_pre_l, rev_pre_len, rev_pre_wpos, pre_spl);
  in_r = buf_read_interp(rev_pre_r, rev_pre_len, rev_pre_wpos, pre_spl);
  rev_pre_wpos += 1;
  rev_pre_wpos >= rev_pre_len ? rev_pre_wpos = 0;

  // Input diffusion allpasses (smears sharp tremolo-picking transients before the FDN tank)
  in_l = allpass_proc(ap_l2, ap_len_l2, rev_state + 17, allpass_proc(ap_l1, ap_len_l1, rev_state + 16, in_l, rev_ap_g), rev_ap_g);
  in_r = allpass_proc(ap_r2, ap_len_r2, rev_state + 19, allpass_proc(ap_r1, ap_len_r1, rev_state + 18, in_r, rev_ap_g), rev_ap_g);

  rev_mod_ph += rev_mod_inc; rev_mod_ph >= 2.0 * $pi ? rev_mod_ph -= 2.0 * $pi;
  m1 = sin(rev_mod_ph) * rev_mod_d; m2 = cos(rev_mod_ph) * rev_mod_d;

  // Read modulated FDN lines + per-line 1-pole damping
  y0 = fdn_read(comb_l1, comb_max, rev_state[0], c_len_l1 + m1); rev_state[8]  = rev_state[8]  * rev_damp + y0 * (1.0 - rev_damp); y0 = rev_state[8];
  y1 = fdn_read(comb_l2, comb_max, rev_state[1], c_len_l2 - m2); rev_state[9]  = rev_state[9]  * rev_damp + y1 * (1.0 - rev_damp); y1 = rev_state[9];
  y2 = fdn_read(comb_l3, comb_max, rev_state[2], c_len_l3 - m1); rev_state[10] = rev_state[10] * rev_damp + y2 * (1.0 - rev_damp); y2 = rev_state[10];
  y3 = fdn_read(comb_l4, comb_max, rev_state[3], c_len_l4 + m2); rev_state[11] = rev_state[11] * rev_damp + y3 * (1.0 - rev_damp); y3 = rev_state[11];

  yr0 = fdn_read(comb_r1, comb_max, rev_state[4], c_len_r1 - m1); rev_state[12] = rev_state[12] * rev_damp + yr0 * (1.0 - rev_damp); yr0 = rev_state[12];
  yr1 = fdn_read(comb_r2, comb_max, rev_state[5], c_len_r2 + m2); rev_state[13] = rev_state[13] * rev_damp + yr1 * (1.0 - rev_damp); yr1 = rev_state[13];
  yr2 = fdn_read(comb_r3, comb_max, rev_state[6], c_len_r3 + m1); rev_state[14] = rev_state[14] * rev_damp + yr2 * (1.0 - rev_damp); yr2 = rev_state[14];
  yr3 = fdn_read(comb_r4, comb_max, rev_state[7], c_len_r4 - m2); rev_state[15] = rev_state[15] * rev_damp + yr3 * (1.0 - rev_damp); yr3 = rev_state[15];

  // Orthogonal 4x4 Hadamard feedback (0.5 * H4) + decorrelated input injection
  a = y0 + y1; b = y0 - y1; c = y2 + y3; d = y2 - y3;
  fdn_write(comb_l1, comb_max, rev_state + 0, in_l * 0.5 + (a + c) * 0.5 * c_fb_l1);
  fdn_write(comb_l2, comb_max, rev_state + 1, -in_l * 0.5 + (b + d) * 0.5 * c_fb_l2);
  fdn_write(comb_l3, comb_max, rev_state + 2, in_l * 0.5 + (a - c) * 0.5 * c_fb_l3);
  fdn_write(comb_l4, comb_max, rev_state + 3, -in_l * 0.5 + (b - d) * 0.5 * c_fb_l4);

  a = yr0 + yr1; b = yr0 - yr1; c = yr2 + yr3; d = yr2 - yr3;
  fdn_write(comb_r1, comb_max, rev_state + 4, in_r * 0.5 + (a + c) * 0.5 * c_fb_r1);
  fdn_write(comb_r2, comb_max, rev_state + 5, -in_r * 0.5 + (b + d) * 0.5 * c_fb_r2);
  fdn_write(comb_r3, comb_max, rev_state + 6, in_r * 0.5 + (a - c) * 0.5 * c_fb_r3);
  fdn_write(comb_r4, comb_max, rev_state + 7, -in_r * 0.5 + (b - d) * 0.5 * c_fb_r4);

  sum_l = bq_proc_l(bq_rev_shelf, (y0 - y1 + y2 - y3) * 0.35);
  sum_r = bq_proc_r(bq_rev_shelf, (yr0 - yr1 + yr2 - yr3) * 0.35);

  // Symmetric stereo cross-wash in Ambient mode
  rev_mode == 2 ? (
    cross_l = 0.78 * sum_l + 0.22 * sum_r;
    cross_r = 0.78 * sum_r + 0.22 * sum_l;
    sum_l = cross_l; sum_r = cross_r;
  );

  spl0 = spl0 * (1.0 - rev_en_s * reverb_mix_s * 0.45) + sum_l * reverb_mix_s;
  spl1 = spl1 * (1.0 - rev_en_s * reverb_mix_s * 0.45) + sum_r * reverb_mix_s;
  !en && rev_en_s <= 0.0001 ? ( max(abs(sum_l), abs(sum_r)) < 0.000001 ? ( rev_idle += 1; ) : ( rev_idle = 0; ); );
  );
);
