desc:Sepulchre Sound (Raw Black Metal Pedalboard)
// tags: guitar amplifier distortion chorus delay reverb black-metal lo-fi
// author: Sepulchre Audio

// Module 0: Input & Gate
slider1:0.0<-12.0,18.0,0.1>-Input Trim (dB)
slider2:105.0<40.0,180.0,1.0>-Pre-Cut HPF (Hz)
slider3:-52.0<-80.0,-30.0,0.5>-Gate Threshold (dB)
slider4:1<0,1,1{Off,On}>-Noise Gate Enable

// Dynamic Middle Routing Slots (0=Dirt, 1=Frost, 2=Echo, 3=Cavern)
slider5:0<0,3,1{Dirt,Frost,Echo,Cavern}>-Slot A Module
slider6:1<0,3,1{Dirt,Frost,Echo,Cavern}>-Slot B Module
slider7:2<0,3,1{Dirt,Frost,Echo,Cavern}>-Slot C Module
slider8:3<0,3,1{Dirt,Frost,Echo,Cavern}>-Slot D Module

// Module 1: Dirt (Distortion)
slider10:1<0,1,1{Bypass,On}>-Dirt Enable
slider11:0<0,2,1{Rodent,Fang,Chainsaw}>-Dirt Mode
slider12:76<0,100,1>-Dirt Drive (%)
slider13:45<0,100,1>-Dirt Pre-Low (%)
slider14:68<0,100,1>-Dirt Pre-Mid (%)
slider15:64<0,100,1>-Dirt Pre-High (%)
slider16:20<0,100,1>-Dirt Grit (%)
slider17:0.0<-18.0,12.0,0.1>-Dirt Output (dB)

// Module 2: Frost (Chorus)
slider20:1<0,1,1{Bypass,On}>-Frost Enable
slider21:0<0,1,1{Analog BBD,Dimension}>-Frost Mode
slider22:0.45<0.1,4.0,0.01>-Frost Rate (Hz)
slider23:58<0,100,1>-Frost Depth (%)
slider24:44<0,100,1>-Frost Tone (%)
slider25:38<0,100,1>-Frost Mix (%)

// Module 3: Echo (Delay)
slider30:1<0,1,1{Bypass,On}>-Echo Enable
slider31:0<0,1,1{Tape / BBD,Digital 80s}>-Echo Mode
slider32:390<20,800,1>-Echo Time (ms)
slider33:42<0,105,1>-Echo Feedback (%)
slider34:36<0,100,1>-Echo Tone (%)
slider35:28<0,100,1>-Echo Mix (%)
slider36:0<0,1,1{Off,On}>-Echo Tempo Sync

// Module 4: Cavern (Reverb)
slider40:1<0,1,1{Bypass,On}>-Cavern Enable
slider41:0<0,2,1{Crypt Hall,Cold Plate,Abyss}>-Cavern Mode
slider42:3.2<0.5,10.0,0.1>-Cavern Decay (s)
slider43:22<0,60,1>-Cavern Pre-Delay (ms)
slider44:62<0,100,1>-Cavern Dampening (%)
slider45:26<0,100,1>-Cavern Mix (%)

// Module 5: Cabinet Shaper & Master
slider49:1<0,1,1{Bypass,On}>-Cabinet Enable
slider50:0<0,2,1{Raw 4x12,Cold 2x12,Dark Crypt}>-Cabinet Profile
slider51:0.0<-24.0,6.0,0.1>-Master Output (dB)

// Global Template State
slider60:1<0,2,1{Human Worms,Transylvanian Frost,Crypt Drone}>-Global Preset

import sepulchre_dsp_core.jsfx-inc
import sepulchre_dsp_fx.jsfx-inc
import sepulchre_presets.jsfx-inc
import sepulchre_ui.jsfx-inc

@init
ext_noinit = 1;
!dsp_initialized ? (
  mem_top = 1024;
  init_core_dsp();
  init_fx_dsp();
  dirt_preset_idx = 0;
  frost_preset_idx = 0;
  echo_preset_idx = 1;
  cavern_preset_idx = 0;
  dsp_initialized = 1;
);
sync_all_DSP();

@slider
sync_all_DSP();

@block
last_srate != srate ? (
  last_srate = srate;
  sync_all_DSP();
);

@sample
function dispatch_slot(mod_id) (
  mod_id == 0 ? proc_dirt() :
  mod_id == 1 ? proc_frost() :
  mod_id == 2 ? proc_echo() :
  proc_cavern();
);

proc_input_gate();
dispatch_slot(slider5);
dispatch_slot(slider6);
dispatch_slot(slider7);
dispatch_slot(slider8);
proc_cab_master();

@gfx 1140 430
col_bg();
gfx_rect(0, 0, gfx_w, gfx_h);

ui_mouse_down = mouse_cap & 1;
ui_mouse_clicked = ui_mouse_down && !ui_last_mouse_down;
!ui_mouse_down ? ui_drag_id = 0;
ui_last_mouse_down = ui_mouse_down;
ui_param_changed = 0;

// Top Banner & Global Presets
col_header(); draw_box(12, 10, 1116, 42, 1);
col_steel();  draw_box(12, 10, 1116, 42, 0);

gfx_setfont(1, "Consolas", 18, 'b');
col_bone();
gfx_x = 26; gfx_y = 21;
gfx_drawstr("SEPULCHRE SOUND");
gfx_setfont(1, "Consolas", 12, 'b');
col_crimson();
gfx_x = 200; gfx_y = 25;
gfx_drawstr("// RAW BLACK METAL SIGNAL CHAIN");

col_dim();
gfx_x = 580; gfx_y = 25;
gfx_drawstr("GLOBAL RITUAL:");
ui_button(695, 19, 132, 24, "HUMAN WORMS", slider60 == 0) ? recall_global_preset(0);
ui_button(835, 19, 152, 24, "TRANSYLVANIAN FROST", slider60 == 1) ? recall_global_preset(1);
ui_button(995, 19, 122, 24, "CRYPT DRONE", slider60 == 2) ? recall_global_preset(2);

// Module 0: Input & Gate (Left Column)
col_chassis(); draw_box(12, 62, 168, 354, 1);
col_header();  draw_box(12, 62, 168, 28, 1);
col_steel();   draw_box(12, 62, 168, 354, 0);
gfx_line(12, 90, 180, 90);
col_bone(); gfx_x = 42; gfx_y = 70; gfx_drawstr("00: INPUT / GATE");

slider1 = ui_hslider(1, 22, 105, 148, "INPUT TRIM", slider1, -12.0, 18.0, 0.1, "%+.1f dB");
slider2 = ui_hslider(2, 22, 155, 148, "PRE-CUT HPF", slider2, 40.0, 180.0, 1.0, "%d Hz");
ui_button(22, 210, 148, 22, slider4 > 0.5 ? "NOISE GATE: ON" : "NOISE GATE: OFF", slider4 > 0.5) ? ( slider4 = !(slider4 > 0.5); ui_param_changed = 1; );
slider3 = ui_hslider(3, 22, 246, 148, "GATE THRESH", slider3, -80.0, -30.0, 0.5, "%.1f dB");

// Gate Status Bar
col_dim(); gfx_x = 22; gfx_y = 305; gfx_drawstr("CLAMP STATE:");
col_bg(); draw_box(22, 322, 148, 12, 1);
gate_gain > 0.05 ? ( col_crimson(); draw_box(23, 323, floor(146 * gate_gain), 10, 1); );
col_steel(); draw_box(22, 322, 148, 12, 0);

// 4 Swappable Middle Pedalboard Slots
draw_middle_module(slider5, 0, 190, 62, 182, 354);
draw_middle_module(slider6, 1, 380, 62, 182, 354);
draw_middle_module(slider7, 2, 570, 62, 182, 354);
draw_middle_module(slider8, 3, 760, 62, 182, 354);

// Module 5: Cabinet Shaper & Master (Right Column)
col_chassis(); draw_box(952, 62, 176, 354, 1);
col_header();  draw_box(952, 62, 176, 28, 1);
col_steel();   draw_box(952, 62, 176, 354, 0);
gfx_line(952, 90, 1128, 90);
ui_button(962, 67, 156, 18, slider49 > 0.5 ? "05: CAB SIM [ON]" : "05: CAB SIM [BYP]", slider49 > 0.5) ? ( slider49 = !(slider49 > 0.5); ui_param_changed = 1; );

col_dim(); gfx_x = 962; gfx_y = 102; gfx_drawstr("CABINET PROFILE:");
ui_button(962, 120, 156, 24, "RAW 4x12 (V30/SM57)", slider50 == 0) ? ( slider50 = 0; ui_param_changed = 1; );
ui_button(962, 150, 156, 24, "COLD 2x12 (COMBO)", slider50 == 1) ? ( slider50 = 1; ui_param_changed = 1; );
ui_button(962, 180, 156, 24, "DARK CRYPT (DAMPED)", slider50 == 2) ? ( slider50 = 2; ui_param_changed = 1; );

col_dim(); gfx_x = 962; gfx_y = 224; gfx_drawstr("FIXED FILTERS:");
col_bone(); gfx_x = 962; gfx_y = 242; gfx_drawstr("HPF: 90 Hz / LPF: 5.5 kHz");

slider51 = ui_hslider(51, 962, 285, 156, "MASTER OUTPUT", slider51, -24.0, 6.0, 0.1, "%+.1f dB");

ui_param_changed ? sync_all_DSP();
