desc:Sepulchre Sound (Raw Black Metal Pedalboard)
// tags: guitar amplifier distortion chorus delay reverb black-metal lo-fi
// author: Sepulchre Audio

// Module 0: Input & Gate
slider1:0.0<-12.0,18.0,0.1>-Input Trim (dB)
slider2:105.0<40.0,180.0,1.0>-Pre-Cut HPF (Hz)
slider3:-52.0<-80.0,-30.0,0.5>-Gate Threshold (dB)
slider4:1<0,1,1{Off,On}>-Noise Gate Enable

// Dynamic Middle Routing Slots (0=Distortion, 1=Chorus, 2=Delay, 3=Reverb)
slider5:0<0,3,1{Distortion,Chorus,Delay,Reverb}>-Slot A Module
slider6:1<0,3,1{Distortion,Chorus,Delay,Reverb}>-Slot B Module
slider7:2<0,3,1{Distortion,Chorus,Delay,Reverb}>-Slot C Module
slider8:3<0,3,1{Distortion,Chorus,Delay,Reverb}>-Slot D Module

// Module 1: Distortion
slider10:1<0,1,1{Bypass,On}>-Distortion Enable
slider11:0<0,2,1{RAT,Modern High-Gain,HM-2}>-Distortion Mode
slider12:76<0,100,1>-Distortion Drive (%)
slider13:45<0,100,1>-Distortion Pre-Low (%)
slider14:68<0,100,1>-Distortion Pre-Mid (%)
slider15:64<0,100,1>-Distortion Pre-High (%)
slider16:20<0,100,1>-Distortion Grit (%)
slider17:0.5<-18.0,12.0,0.1>-Distortion Output (dB)

// Module 2: Chorus
slider20:1<0,1,1{Bypass,On}>-Chorus Enable
slider21:0<0,1,1{Analog BBD,Dimension}>-Chorus Mode
slider22:0.45<0.1,4.0,0.01>-Chorus Rate (Hz)
slider23:58<0,100,1>-Chorus Depth (%)
slider24:44<0,100,1>-Chorus Tone (%)
slider25:38<0,100,1>-Chorus Mix (%)

// Module 3: Delay
slider30:1<0,1,1{Bypass,On}>-Delay Enable
slider31:0<0,1,1{Tape,Digital}>-Delay Mode
slider32:390<20,800,1>-Delay Time (ms)
slider33:42<0,105,1>-Delay Feedback (%)
slider34:36<0,100,1>-Delay Tone (%)
slider35:28<0,100,1>-Delay Mix (%)
slider36:0<0,1,1{Off,On}>-Delay Tempo Sync

// Module 4: Reverb
slider40:1<0,1,1{Bypass,On}>-Reverb Enable
slider41:0<0,2,1{Hall,Plate,Ambient}>-Reverb Mode
slider42:3.2<0.5,10.0,0.1>-Reverb Decay (s)
slider43:22<0,60,1>-Reverb Pre-Delay (ms)
slider44:62<0,100,1>-Reverb Dampening (%)
slider45:26<0,100,1>-Reverb Mix (%)

// Module 5: Amp Stage, IR Loader / Cabinet Shaper & Master
slider49:1<0,1,1{Bypass,On}>-Cabinet Enable
slider50:0<0,2,1{4x12 V30/SM57,2x12 Combo,4x12 Damped}>-Cabinet Profile
slider51:-0.5<-24.0,6.0,0.1>-Master Output (dB)
slider53:/sepulchre_irs:none:Cabinet WAV Impulse
slider54:1<0,2,1{Off,Tube Head,Solid-State}>-Amp Stage Mode
slider55:54<0,100,1>-Amp Bass (%)
slider56:52<0,100,1>-Amp Mid (%)
slider57:62<0,100,1>-Amp Treble (%)
slider58:64<0,100,1>-Amp Presence / Air (%)

// Global Template State
slider60:0<0,6,1{Tight Rhythm,Cold Lead,Doom Wall,Raw 4-Track,Swedish Chainsaw,Freezing Clean,Ambient Swell}>-Global Preset

import sepulchre_dsp_core.jsfx-inc
import sepulchre_dsp_fx.jsfx-inc
import sepulchre_dsp_amp_cab.jsfx-inc
import sepulchre_presets.jsfx-inc
import sepulchre_ui.jsfx-inc

@init
ext_noinit = 1;
!dsp_initialized ? (
  mem_top = 1024;
  init_core_dsp();
  init_fx_dsp();
  init_amp_cab_dsp();
  dist_preset_idx = 0;
  chorus_preset_idx = 0;
  delay_preset_idx = 1;
  reverb_preset_idx = 0;
  last_global_preset = slider60;
  dsp_initialized = 1;
  recall_global_preset(slider60);
);
sync_all_DSP();

@slider
slider60 != last_global_preset ? (
  recall_global_preset(slider60);
);
ui_need_sync = 1;

@block
// Clear stale tails when transport starts playback or rendering
(play_state & 1) && !(last_play_state & 1) ? (
  reset_core_state();
  reset_fx_state();
  reset_amp_cab_state();
);
last_play_state = play_state;

(last_srate != srate || ui_need_sync) ? (
  last_srate = srate;
  ui_need_sync = 0;
  sync_all_DSP();
);
ir_need_refft ? prepare_ir_fft();

@sample
function dispatch_slot(mod_id) (
  mod_id == 0 ? proc_distortion() :
  mod_id == 1 ? proc_chorus() :
  mod_id == 2 ? proc_delay() :
  proc_reverb();
);

proc_input_gate();
dispatch_slot(slider5);
dispatch_slot(slider6);
dispatch_slot(slider7);
dispatch_slot(slider8);
proc_cab_master();

@gfx 1140 430
col_bg();
gfx_rect(0, 0, gfx_w, gfx_h);

ui_mouse_down = mouse_cap & 1;
ui_mouse_clicked = ui_mouse_down && !ui_last_mouse_down;
!ui_mouse_down ? ui_drag_id = 0;
ui_last_mouse_down = ui_mouse_down;

// Top Banner & Global Presets
col_header(); draw_box(12, 10, 1116, 42, 1);
col_steel();  draw_box(12, 10, 1116, 42, 0);

gfx_setfont(1, "Consolas", 18, 'b');
col_bone(); gfx_x = 26; gfx_y = 21; gfx_drawstr("SEPULCHRE SOUND");
gfx_setfont(1, "Consolas", 11, 'b');
col_crimson(); gfx_x = 200; gfx_y = 25; gfx_drawstr("// 4x OVERSAMPLED BLACK METAL RIG");

col_dim(); gfx_x = 760; gfx_y = 25; gfx_drawstr("PRESET:");
draw_preset_dropdown_bar(825, 19, 292, 24);

// Module 0: Input & Gate (Left Column)
col_chassis(); draw_box(12, 62, 168, 354, 1);
col_header();  draw_box(12, 62, 168, 28, 1);
col_steel();   draw_box(12, 62, 168, 354, 0);
gfx_line(12, 90, 180, 90);
col_bone(); gfx_x = 42; gfx_y = 70; gfx_drawstr("00: INPUT / GATE");

slider1 = ui_hslider(1, 22, 102, 148, "INPUT TRIM", slider1, -12.0, 18.0, 0.1, "%+.1f dB");
slider2 = ui_hslider(2, 22, 148, 148, "PRE-CUT HPF", slider2, 40.0, 180.0, 1.0, "%d Hz");
ui_button(22, 194, 148, 20, slider4 > 0.5 ? "NOISE GATE: ON" : "NOISE GATE: OFF", slider4 > 0.5) ? ( slider4 = !(slider4 > 0.5); slider_automate(slider4); ui_need_sync = 1; preset_dirty = 1; );
slider3 = ui_hslider(3, 22, 224, 148, "GATE THRESH", slider3, -80.0, -30.0, 0.5, "%.1f dB");

col_dim(); gfx_x = 22; gfx_y = 272; gfx_drawstr("GATE CLAMP:");
col_bg(); draw_box(22, 286, 148, 9, 1);
gate_gain > 0.05 ? ( col_crimson(); draw_box(23, 287, floor(146 * gate_gain), 7, 1); );
col_steel(); draw_box(22, 286, 148, 9, 0);

draw_level_meter(22, 310, 148, "INPUT LEVEL", meter_in_peak);
draw_level_meter(22, 352, 148, "OUTPUT (-10..-8)", meter_out_peak);

// 4 Swappable Middle Pedalboard Slots
draw_middle_module(slider5, 0, 190, 62, 182, 354);
draw_middle_module(slider6, 1, 380, 62, 182, 354);
draw_middle_module(slider7, 2, 570, 62, 182, 354);
draw_middle_module(slider8, 3, 760, 62, 182, 354);

// Module 5: Amp Stage, IR / Cab Shaper & Master (Right Column)
col_chassis(); draw_box(952, 62, 176, 354, 1);
col_header();  draw_box(952, 62, 176, 28, 1);
col_steel();   draw_box(952, 62, 176, 354, 0);
gfx_line(952, 90, 1128, 90);
ui_button(962, 67, 156, 18, slider49 > 0.5 ? "05: AMP / CAB [ON]" : "05: AMP / CAB [BYP]", slider49 > 0.5) ? ( slider49 = !(slider49 > 0.5); slider_automate(slider49); ui_need_sync = 1; preset_dirty = 1; );

ui_button(962, 98, 44, 18, "OFF", slider54 == 0) ? ( slider54 = 0; slider_automate(slider54); ui_need_sync = 1; preset_dirty = 1; );
ui_button(1009, 98, 52, 18, "TUBE", slider54 == 1) ? ( slider54 = 1; slider_automate(slider54); ui_need_sync = 1; preset_dirty = 1; );
ui_button(1064, 98, 54, 18, "SOLID", slider54 == 2) ? ( slider54 = 2; slider_automate(slider54); ui_need_sync = 1; preset_dirty = 1; );

ui_button(962, 122, 48, 18, "4x12", slider50 == 0 && slider53 == 0) ? ( slider53 = 0; slider50 = 0; slider_automate(slider50); ui_need_sync = 1; preset_dirty = 1; );
ui_button(1013, 122, 48, 18, "2x12", slider50 == 1 && slider53 == 0) ? ( slider53 = 0; slider50 = 1; slider_automate(slider50); ui_need_sync = 1; preset_dirty = 1; );
ui_button(1064, 122, 54, 18, "DAMPED", slider50 == 2 && slider53 == 0) ? ( slider53 = 0; slider50 = 2; slider_automate(slider50); ui_need_sync = 1; preset_dirty = 1; );

slider53 = ui_hslider(53, 962, 146, 156, slider53 > 0.5 ? "WAV IR SLOT (ACTIVE)" : "WAV IR (0=IIR CAB)", slider53, 0, 10, 1, "#%d");
slider55 = ui_hslider(55, 962, 180, 156, "AMP BASS", slider55, 0, 100, 1, "%d%%");
slider56 = ui_hslider(56, 962, 214, 156, "AMP MID", slider56, 0, 100, 1, "%d%%");
slider57 = ui_hslider(57, 962, 248, 156, "AMP TREBLE", slider57, 0, 100, 1, "%d%%");
slider58 = ui_hslider(58, 962, 282, 156, "PRESENCE / AIR", slider58, 0, 100, 1, "%d%%");
slider51 = ui_hslider(51, 962, 316, 156, "MASTER OUTPUT", slider51, -24.0, 6.0, 0.1, "%+.1f dB");

draw_level_meter(962, 356, 156, "MASTER PEAK", meter_out_peak);

// Draw preset dropdown menu overlay last so it renders on top of all modules
draw_preset_dropdown_menu(825, 43, 292, 24);
