desc:Sepulchre Sound (Raw Black Metal Pedalboard)
// tags: guitar amplifier distortion eq chorus reverb black-metal
// author: Sepulchre Audio

// Input & Gate
slider1:0.0<-12.0,18.0,0.1>-Input Trim (dB)
slider2:140<40.0,180.0,1.0>-Pre-Cut HPF (Hz)
slider3:-50<-80.0,-30.0,0.5>-Gate Threshold (dB)
slider4:1<0,1,1{Off,On}>-Noise Gate Enable

// Round 42: fixed signal chain (no routing slots), amp FX loop:
// Input/Gate -> [EQ if Before] -> Pedal -> [EQ if After] -> Amp -> Chorus -> Reverb -> Cab (WAV IR) -> Air/Master
slider76:1<0,1,1{Before Pedal,After Pedal}>-EQ Position

// Distortion: four pedal models, each with only its real knobs (0..10 like the hardware)
slider10:1<0,1,1{Bypass,On}>-Distortion Enable
slider11:1<0,3,1{RAT,DS-1,Metal Zone,HM-2}>-Distortion Pedal
slider26:8.0<0,10,0.1>-RAT Distortion
slider27:3.5<0,10,0.1>-RAT Filter
slider28:6.7<0,10,0.1>-RAT Volume
slider29:10<0,10,0.1>-DS-1 Dist
slider37:7.5<0,10,0.1>-DS-1 Tone
slider38:8<0,10,0.1>-DS-1 Level
slider39:7.5<0,10,0.1>-Metal Zone Dist
slider46:6.5<0,10,0.1>-Metal Zone High
slider47:4.5<0,10,0.1>-Metal Zone Low
slider48:6.0<0,10,0.1>-Metal Zone Middle
slider59:4.5<0,10,0.1>-Metal Zone Mid Freq
slider61:7.5<0,10,0.1>-Metal Zone Level
slider62:10.0<0,10,0.1>-HM-2 Distortion
slider63:10.0<0,10,0.1>-HM-2 Low
slider64:10.0<0,10,0.1>-HM-2 High
slider9:4.4<0,10,0.1>-HM-2 Level

// Chorus (Round 42: Boss CE-2 model, Rate + Depth only, 50/50 mix like the pedal)
slider20:0<0,1,1{Bypass,On}>-Chorus Enable
slider77:4.5<0,10,0.1>-CE-2 Rate
slider78:4<0,10,0.1>-CE-2 Depth

// Reverb
slider40:1<0,1,1{Bypass,On}>-Reverb Enable
slider41:0<0,2,1{Hall,Plate,Ambient}>-Reverb Mode
slider42:1.8<0.5,10.0,0.1>-Reverb Decay (s)
slider43:20<0,60,1>-Reverb Pre-Delay (ms)
slider44:60<0,100,1>-Reverb Dampening (%)
slider45:10<0,100,1>-Reverb Mix (%)

// EQ (Round 31): Boss GE-7 style 7-band graphic EQ (+/-15 dB bands, +/-15 dB level)
slider65:1<0,1,1{Bypass,On}>-EQ Enable
slider66:-9<-15,15,0.5>-EQ 100 Hz (dB)
slider67:-2<-15,15,0.5>-EQ 200 Hz (dB)
slider68:0<-15,15,0.5>-EQ 400 Hz (dB)
slider69:12<-15,15,0.5>-EQ 800 Hz (dB)
slider70:-2<-15,15,0.5>-EQ 1.6 kHz (dB)
slider71:9<-15,15,0.5>-EQ 3.2 kHz (dB)
slider72:-3.5<-15,15,0.5>-EQ 6.4 kHz (dB)
slider73:-0.5<-15,15,0.5>-EQ Level (dB)
slider75:3<0,8,1{Custom,Bathory,Deathcrush,Transilvanian Hunger,Nightside Eclipse,Filosofem,In Sorte Diaboli,Evangelion,Spectre}>-EQ Preset

// Amp, Cabinet (WAV IR) & Master
slider49:1<0,1,1{Bypass,On}>-Cabinet Enable
slider51:-3.8<-24.0,6.0,0.1>-Master Output (dB)
slider53:/sepulchre_irs:none:-Cabinet IR
slider54:2<0,2,1{Off,Tube Head,Solid-State}>-Amp Stage Mode
slider55:40<0,100,1>-Amp Bass (%)
slider56:50<0,100,1>-Amp Mid (%)
slider57:66<0,100,1>-Amp Treble (%)
slider58:66<0,100,1>-Amp Presence / Air (%)

// Global Template State (Round 55: 10 black metal presets; slider defaults = preset 01 so a fresh insert matches its name)
slider60:0<0,9,1{Frostbitten,Tremolo Rhythm,Raw 4-Track,Buzzsaw,Atmospheric Wall,Depressive,Modern Black,Cold Lead,Freezing Clean,Ambient Swell}>-Global Preset

// UI artwork (must sit next to this file; deploy copies *.jpg / *.png too)
filename:0,sepulchre_bg.jpg
filename:1,sepulchre_titles.png

import sepulchre_dsp_core.jsfx-inc
import sepulchre_dsp_dist.jsfx-inc
import sepulchre_dsp_fx.jsfx-inc
import sepulchre_dsp_amp_cab.jsfx-inc
import sepulchre_presets.jsfx-inc
import sepulchre_ui.jsfx-inc
import sepulchre_ui_panels.jsfx-inc

@init
ext_noinit = 1;
!dsp_initialized ? (
  mem_top = 1024;
  init_core_dsp();
  init_fx_dsp();
  init_amp_cab_dsp();
  dsp_initialized = 1;
  // Do NOT call recall_global_preset() here so saved REAPER project settings are preserved (Fixes R2-1)
  ir_loaded_slot = -1;
  eq_last_preset = floor(slider75 + 0.5);   // saved fader values win over the preset table on project load
  gp_last = floor(slider60 + 0.5);          // same for the global preset (R2-1: never recall on load)
  load_ir_slot(max(0, floor(slider53 + 0.001)));
  snap_all_sliders();
);
sync_all_DSP();

@slider
!ir_counted ? ( scan_ir_count(); ir_counted = 1; );
// Round 67 (H2): only recall factory presets when slider75/60 changed alone (preserves REAPER user presets & undo)
eq_p = floor(slider75 + 0.5);
eq_p != eq_last_preset ? ( !other_sliders_changed(75) ? recall_eq_preset(eq_p) : ( eq_last_preset = eq_p; ); );
gp_p = floor(slider60 + 0.5);
gp_p != gp_last ? ( !other_sliders_changed(60) ? recall_global_preset(gp_p) : ( gp_last = gp_p; ); );
tmp_ir_idx = max(0, floor(slider53 + 0.001));
tmp_ir_idx != ir_loaded_slot ? load_ir_slot(tmp_ir_idx);
snap_all_sliders();
ui_need_sync = 1;

@block
// One-shot IR WAV load when @gfx changes slider53 (Fixes R3-1)
ir_reload_req ? (
  ir_reload_req = 0;
  load_ir_slot(max(0, floor(slider53 + 0.001)));
);

(last_srate != srate || ui_need_sync) ? (
  last_srate != srate && ir_raw_len > 0 ? ir_need_refft = 1;   // re-resample the IR at the new rate
  last_srate = srate;
  ui_need_sync = 0;
  sync_all_DSP();
);

// Clear stale tails when transport starts playback or rendering
(play_state & 1) && !(last_play_state & 1) ? (
  reset_core_state();
  reset_dist_state();
  reset_fx_state();
  reset_amp_cab_state();
  dist_mix_s = slider10 > 0.5; eq_mix_s = slider65 > 0.5; chorus_mix_s = slider20 > 0.5;   // full mix from sample 0
);
last_play_state = play_state;

ir_need_refft ? prepare_ir_fft();

// Report overlap-add convolution latency to REAPER PDC when WAV IR is active (Fixes R2-3)
(slider49 > 0.5 && ir_filter_len > 0) ? (
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = ir_chunk_size;
) : (
  pdc_delay = 0;
);

@sample
proc_input_gate();
slider76 < 0.5 ? proc_eq();
proc_distortion();
slider76 >= 0.5 ? proc_eq();
proc_amp();
proc_chorus();
proc_reverb();
proc_cab_out();

@serialize
// Round 55: keep the "edited" asterisks across project save / reload
file_var(0, preset_dirty);
file_var(0, eq_dirty);

@gfx 1204 500
// "Crypt" UI: baked background + title sprites, live widgets (sepulchre_ui.jsfx-inc / sepulchre_ui_panels.jsfx-inc)
ui_begin();
ui_load_images();
ui_draw_background();

ui_mouse_down = mouse_cap & 1;
ui_mouse_clicked = ui_mouse_down && !ui_last_mouse_down;
// Drag release + automation end-touch: ui_begin() / ui_hslider() (Round 16)
ui_last_mouse_down = ui_mouse_down;

ui_draw_all();
