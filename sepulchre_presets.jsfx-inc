// sepulchre_presets.jsfx-inc
// Global presets (Round 55: 10, all black metal), sync_all_DSP, record EQ table and name tables
@init

function sync_all_DSP() (
  update_core_coeffs();
  update_dist_coeffs();
  update_fx_coeffs();
  update_amp_cab_coeffs();
  update_eq_coeffs();
);

// Round 34: GE-7 settings for classic black metal records, read off Devin's reference photos (approximate, +/-1.5 dB).
// Order: 100, 200, 400, 800, 1.6k, 3.2k, 6.4k, Level (dB). recall_eq_preset() lives in sepulchre_ui_panels (needs auto_slider);
// Round 55: the values live here (eq_preset_vals) so global presets can load a record curve too.
// Level is NOT the photo's +3 (that was relative to each player's amp). Round 35 loudness-matched it on the IIR cab;
// Round 39 re-centred it on the default WAV IR cab (Antigravity R37: mean of Tube/Off deltas), so presets ~= flat there
// and run ~2-3 dB louder than flat on the IIR cab.
function get_eq_preset_name(i) (
  i == 1 ? "BATHORY '84" : i == 2 ? "DEATHCRUSH '87" : i == 3 ? "TRANSILVANIAN '94" : i == 4 ? "NIGHTSIDE '94" :
  i == 5 ? "FILOSOFEM '96" : i == 6 ? "IN SORTE '07" : i == 7 ? "EVANGELION '09" : "CUSTOM";
);
function eq_set8(a, b, c, d, e, f, g, h) (
  slider66 = a; slider67 = b; slider68 = c; slider69 = d; slider70 = e; slider71 = f; slider72 = g; slider73 = h;
);
function eq_preset_vals(i) (
  i == 1 ? eq_set8(-2.5, -12.5, -6, -2.5, 12.5, 9, 3, -3.5) :      // Bathory - Bathory (1984)
  i == 2 ? eq_set8(5, -2, -1, 5.5, -7, 12, -3, -1.5) :          // Mayhem - Deathcrush (1987)
  i == 3 ? eq_set8(-9, -2, 0, 12, -2, 9, -3.5, -0.5) :            // Darkthrone - Transilvanian Hunger (1994)
  i == 4 ? eq_set8(3, 7, -5, -4, 5.5, 7.5, -2, -4.5) :            // Emperor - In the Nightside Eclipse (1994)
  i == 5 ? eq_set8(3.5, 4, -5, 9.5, 12.5, 3.5, 14, -6) :        // Burzum - Filosofem (1996)
  i == 6 ? eq_set8(0, -3.5, -1.5, 3.5, 6, 3.5, 3, 0.5) :         // Dimmu Borgir - In Sorte Diaboli (2007)
  i == 7 ? eq_set8(4, 0, -1, 8, 10, 1, 9.5, -3.5);                // Behemoth - Evangelion (2009)
);
// Record curve into the GE-7, after the pedal (where its Level was matched)
function gp_eq(i) ( eq_preset_vals(i); slider65 = 1; slider76 = 1; slider75 = i; );
// Name table matching %APPDATA%\REAPER\Data\sepulchre_irs\
function get_ir_slot_name(idx) (
  idx == 0 ? "01 BlackWizard C" :
  idx == 1 ? "02 BlackWizard E" :
  idx == 2 ? "03 Destroyer C" :
  idx == 3 ? "04 Destroyer E" :
  idx == 4 ? "05 LordOfGoats C" :
  idx == 5 ? "06 LordOfGoats E" :
  idx == 6 ? "07 MystSatan C" :
  idx == 7 ? "08 Swordman C" :
  idx == 8 ? "09 HeadKrush C" :
             "10 PlagueBearer C";
);

function get_global_preset_name(idx) (
  idx == 0 ? "01: FROSTBITTEN" :
  idx == 1 ? "02: TREMOLO RHYTHM" :
  idx == 2 ? "03: RAW 4-TRACK" :
  idx == 3 ? "04: BUZZSAW" :
  idx == 4 ? "05: ATMOSPHERIC WALL" :
  idx == 5 ? "06: DEPRESSIVE" :
  idx == 6 ? "07: MODERN BLACK" :
  idx == 7 ? "08: COLD LEAD" :
  idx == 8 ? "09: FREEZING CLEAN" :
             "10: AMBIENT SWELL";
);
GP_COUNT = 10;

// Round 55 bank. Every distorted preset peaks at -10..-8 dBFS through the reference cab (tests/verify_jsfx.py) for
// an input peaking around -12 dBFS (the INPUT meter's target zone). The IR slot is left as the player set it.
// Sliders: 1 trim, 2 low cut, 3/4 gate; 10/11 pedal; RAT 26-28, DS-1 29/37/38, MT-2 39/46/47/48/59/61, HM-2 62-64/9;
// 20/77/78 CE-2; 40-45 reverb; 54-58 amp + air; 49 cab, 51 master. EQ is reset to off / flat first.
function recall_global_preset(idx) (
  slider60 = idx; gp_last = idx;
  preset_dirty = 0;
  slider65 = 0; slider76 = 1; slider75 = 0; slider66 = 0; slider67 = 0; slider68 = 0; slider69 = 0; slider70 = 0; slider71 = 0; slider72 = 0; slider73 = 0;
  slider49 = 1;

  idx == 0 ? ( // 01 Frostbitten: DS-1 flat out, solid-state, Transilvanian curve, thin and buzzing
    slider1 = 0.0; slider2 = 140; slider3 = -50; slider4 = 1;
    slider10 = 1; slider11 = 1; slider29 = 10.0; slider37 = 7.5; slider38 = 8.0;
    gp_eq(3);
    slider20 = 0; slider77 = 4.5; slider78 = 4.0;
    slider40 = 1; slider41 = 0; slider42 = 1.8; slider43 = 20; slider44 = 60; slider45 = 10;
    slider54 = 2; slider55 = 40; slider56 = 50; slider57 = 66; slider58 = 66; slider51 = -5.4;
  );
  idx == 1 ? ( // 02 Tremolo Rhythm: MT-2 + tube, tight lows, GE-7 pre curve for articulation
    slider1 = 0.0; slider2 = 120; slider3 = -48; slider4 = 1;
    slider10 = 1; slider11 = 2; slider39 = 7.0; slider46 = 6.0; slider47 = 4.0; slider48 = 6.5; slider59 = 4.5; slider61 = 7.9;
    slider65 = 1; slider76 = 0; slider66 = 0.5; slider67 = 0.5; slider68 = 0; slider69 = -1.5; slider70 = 0.5; slider71 = 2.5; slider72 = 2.5;
    slider20 = 0; slider77 = 5.0; slider78 = 4.5;
    slider40 = 1; slider41 = 0; slider42 = 2.0; slider43 = 18; slider44 = 64; slider45 = 12;
    slider54 = 1; slider55 = 54; slider56 = 44; slider57 = 62; slider58 = 64; slider51 = 0.1;
  );
  idx == 2 ? ( // 03 Raw 4-Track: DS-1 + solid-state combo, cut lows, dry
    slider1 = 0.0; slider2 = 135; slider3 = -50; slider4 = 1;
    slider10 = 1; slider11 = 1; slider29 = 8.5; slider37 = 7.0; slider38 = 8.2;
    slider65 = 1; slider76 = 0; slider66 = -2.5; slider67 = -2; slider68 = 0; slider69 = 3.5; slider70 = 2.5; slider71 = 4; slider72 = 4;
    slider20 = 0; slider77 = 4.5; slider78 = 4.0;
    slider40 = 0; slider41 = 0; slider42 = 1.5; slider43 = 10; slider44 = 70; slider45 = 0;
    slider54 = 2; slider55 = 42; slider56 = 60; slider57 = 68; slider58 = 70; slider51 = -1.0;
  );
  idx == 3 ? ( // 04 Buzzsaw: HM-2 the black metal way (Low down, High up), Bathory curve
    slider1 = 0.0; slider2 = 110; slider3 = -50; slider4 = 1;
    slider10 = 1; slider11 = 3; slider62 = 9.0; slider63 = 6.0; slider64 = 8.0; slider9 = 5.0;
    gp_eq(1);
    slider20 = 0; slider77 = 4.5; slider78 = 5.0;
    slider40 = 1; slider41 = 0; slider42 = 2.2; slider43 = 20; slider44 = 60; slider45 = 14;
    slider54 = 1; slider55 = 45; slider56 = 55; slider57 = 58; slider58 = 62; slider51 = 3.7;
  );
  idx == 4 ? ( // 05 Atmospheric Wall: RAT + tube, CE-2, long hall, Filosofem curve
    slider1 = 0.0; slider2 = 95; slider3 = -54; slider4 = 1;
    slider10 = 1; slider11 = 0; slider26 = 7.5; slider27 = 4.0; slider28 = 6.6;
    gp_eq(5);
    slider20 = 1; slider77 = 3.5; slider78 = 5.5;
    slider40 = 1; slider41 = 0; slider42 = 5.5; slider43 = 30; slider44 = 58; slider45 = 30;
    slider54 = 1; slider55 = 56; slider56 = 50; slider57 = 58; slider58 = 58; slider51 = -0.6;
  );
  idx == 5 ? ( // 06 Depressive: RAT darker and softer, CE-2, long ambient reverb, no EQ
    slider1 = 0.0; slider2 = 90; slider3 = -56; slider4 = 1;
    slider10 = 1; slider11 = 0; slider26 = 6.5; slider27 = 6.0; slider28 = 7.0;
    slider20 = 1; slider77 = 2.5; slider78 = 6.0;
    slider40 = 1; slider41 = 2; slider42 = 6.5; slider43 = 40; slider44 = 70; slider45 = 34;
    slider54 = 1; slider55 = 60; slider56 = 48; slider57 = 50; slider58 = 52; slider51 = -1.1;
  );
  idx == 6 ? ( // 07 Modern Black: MT-2 + tube, polished, Evangelion curve, short plate
    slider1 = 0.0; slider2 = 115; slider3 = -48; slider4 = 1;
    slider10 = 1; slider11 = 2; slider39 = 8.0; slider46 = 6.5; slider47 = 5.0; slider48 = 5.5; slider59 = 5.0; slider61 = 7.5;
    gp_eq(7);
    slider20 = 0; slider77 = 4.5; slider78 = 4.5;
    slider40 = 1; slider41 = 1; slider42 = 1.6; slider43 = 15; slider44 = 60; slider45 = 10;
    slider54 = 1; slider55 = 55; slider56 = 45; slider57 = 62; slider58 = 64; slider51 = -1.9;
  );
  idx == 7 ? ( // 08 Cold Lead: RAT + tube + CE-2 + plate
    slider1 = 0.0; slider2 = 105; slider3 = -52; slider4 = 1;
    slider10 = 1; slider11 = 0; slider26 = 7.5; slider27 = 3.0; slider28 = 6.6;
    slider65 = 1; slider76 = 0; slider66 = -1; slider67 = -1; slider68 = 0.5; slider69 = 3.5; slider70 = 2; slider71 = 2; slider72 = 2;
    slider20 = 1; slider77 = 3.8; slider78 = 5.8;
    slider40 = 1; slider41 = 1; slider42 = 3.0; slider43 = 24; slider44 = 48; slider45 = 24;
    slider54 = 1; slider55 = 48; slider56 = 56; slider57 = 64; slider58 = 66; slider51 = -0.8;
  );
  idx == 8 ? ( // 09 Freezing Clean: no pedal, tube, CE-2, hall
    slider1 = 5.0; slider2 = 75; slider3 = -62; slider4 = 1;
    slider10 = 0; slider11 = 0;
    slider20 = 1; slider77 = 4.8; slider78 = 6.8;
    slider40 = 1; slider41 = 0; slider42 = 4.2; slider43 = 25; slider44 = 42; slider45 = 34;
    slider54 = 1; slider55 = 52; slider56 = 50; slider57 = 64; slider58 = 62; slider51 = 6.0;
  );
  idx == 9 ? ( // 10 Ambient Swell: RAT + tube + CE-2 + 7.8 s ambient reverb
    slider1 = 0.0; slider2 = 100; slider3 = -54; slider4 = 1;
    slider10 = 1; slider11 = 0; slider26 = 6.5; slider27 = 4.0; slider28 = 7.5;
    slider65 = 1; slider76 = 0; slider66 = -0.5; slider67 = -0.5; slider68 = 0.5; slider69 = 2; slider70 = 1; slider71 = 1; slider72 = 1;
    slider20 = 1; slider77 = 4.0; slider78 = 6.4;
    slider40 = 1; slider41 = 2; slider42 = 7.8; slider43 = 40; slider44 = 55; slider45 = 46;
    slider54 = 1; slider55 = 50; slider56 = 54; slider57 = 58; slider58 = 60; slider51 = -3.3;
  );
  eq_last_preset = floor(slider75 + 0.5); eq_dirty = 0;
  ui_need_sync = 1;
);
