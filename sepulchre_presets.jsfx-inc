// sepulchre_presets.jsfx-inc
// Global template recalls (7 presets), sync_all_DSP, and name tables
@init

function sync_all_DSP() (
  update_core_coeffs();
  update_dist_coeffs();
  update_fx_coeffs();
  update_amp_cab_coeffs();
  update_eq_coeffs();
);

// Round 34: GE-7 settings for classic black metal records, read off Devin's reference photos (approximate, +/-1.5 dB).
// Order: 100, 200, 400, 800, 1.6k, 3.2k, 6.4k, Level (dB). recall_eq_preset() lives in sepulchre_ui_panels (needs auto_slider).
// Level is NOT the photo's +3 (that was relative to each player's amp). Round 35 loudness-matched it on the IIR cab;
// Round 39 re-centred it on the default WAV IR cab (Antigravity R37: mean of Tube/Off deltas), so presets ~= flat there
// and run ~2-3 dB louder than flat on the IIR cab.
function get_eq_preset_name(i) (
  i == 1 ? "BATHORY '84" : i == 2 ? "DEATHCRUSH '87" : i == 3 ? "TRANSILVANIAN '94" : i == 4 ? "NIGHTSIDE '94" :
  i == 5 ? "FILOSOFEM '96" : i == 6 ? "IN SORTE '07" : i == 7 ? "EVANGELION '09" : "CUSTOM";
);
function eq_set8(a, b, c, d, e, f, g, h) (
  slider66 = a; slider67 = b; slider68 = c; slider69 = d; slider70 = e; slider71 = f; slider72 = g; slider73 = h;
);
// Name table matching %APPDATA%\REAPER\Data\sepulchre_irs\
function get_ir_slot_name(idx) (
  idx == 0 ? "01 BlackWizard C" :
  idx == 1 ? "02 BlackWizard E" :
  idx == 2 ? "03 Destroyer C" :
  idx == 3 ? "04 Destroyer E" :
  idx == 4 ? "05 LordOfGoats C" :
  idx == 5 ? "06 LordOfGoats E" :
  idx == 6 ? "07 MystSatan C" :
  idx == 7 ? "08 Swordman C" :
  idx == 8 ? "09 HeadKrush C" :
             "10 PlagueBearer C";
);

function get_global_preset_name(idx) (
  idx == 0 ? "01: TIGHT RHYTHM" :
  idx == 1 ? "02: COLD LEAD" :
  idx == 2 ? "03: DOOM WALL" :
  idx == 3 ? "04: RAW 4-TRACK" :
  idx == 4 ? "05: SWEDISH CHAINSAW" :
  idx == 5 ? "06: FREEZING CLEAN" :
             "07: AMBIENT SWELL";
);

// Global Presets (0..6), all calibrated for -10 dBFS to -8 dBFS tracking headroom
function recall_global_preset(idx) (
  slider60 = idx; gp_last = idx;
  preset_dirty = 0;
  slider65 = 0; slider76 = 1; slider75 = 0; slider66 = 0; slider67 = 0; slider68 = 0; slider69 = 0; slider70 = 0; slider71 = 0; slider72 = 0; slider73 = 0;

  idx == 0 ? ( // 01: Tight Rhythm (Metal Zone + Tube Amp + WAV IR)
    slider1 = 0.0; slider2 = 120; slider3 = -48; slider4 = 1;
    slider10 = 1; slider11 = 2; slider39 = 7.0; slider46 = 6.0; slider47 = 4.0; slider48 = 6.5; slider59 = 4.5; slider61 = 7.9;
    slider65 = 1; slider76 = 0; slider66 = 0.5; slider67 = 0.5; slider68 = 0; slider69 = -1.5; slider70 = 0.5; slider71 = 2.5; slider72 = 2.5;   // Round 42: was the Input Pre-EQ
    slider20 = 0; slider77 = 5.0; slider78 = 4.5;   // CE-2
    slider40 = 1; slider41 = 0; slider42 = 2.0; slider43 = 18; slider44 = 64; slider45 = 15;
    slider49 = 1; slider51 = -0.5;
    slider54 = 1; slider55 = 54; slider56 = 44; slider57 = 62; slider58 = 64;
  ) : idx == 1 ? ( // 02: Cold Lead (RAT + Tube Amp + CE-2 + Plate Reverb)
    slider1 = 0.0; slider2 = 105; slider3 = -52; slider4 = 1;
    slider10 = 1; slider11 = 0; slider26 = 7.5; slider27 = 3.0; slider28 = 6.6;
    slider65 = 1; slider76 = 0; slider66 = -1; slider67 = -1; slider68 = 0.5; slider69 = 3.5; slider70 = 2; slider71 = 2; slider72 = 2;   // Round 42: was the Input Pre-EQ
    slider20 = 1; slider77 = 3.8; slider78 = 5.8;   // CE-2
    slider40 = 1; slider41 = 1; slider42 = 3.0; slider43 = 24; slider44 = 48; slider45 = 24;
    slider49 = 1; slider51 = -0.5;
    slider54 = 1; slider55 = 48; slider56 = 56; slider57 = 64; slider58 = 66;
  ) : idx == 2 ? ( // 03: Doom Wall (HM-2 + Tube Amp + CE-2 + Ambient Reverb)
    slider1 = 0.0; slider2 = 85; slider3 = -52; slider4 = 1;
    slider10 = 1; slider11 = 3; slider62 = 8.5; slider63 = 8.0; slider64 = 7.5; slider9 = 6.9;
    slider20 = 1; slider77 = 3.5; slider78 = 5.5;   // CE-2
    slider40 = 1; slider41 = 2; slider42 = 6.0; slider43 = 32; slider44 = 62; slider45 = 34;
    slider49 = 1; slider51 = -1.0;
    slider54 = 1; slider55 = 62; slider56 = 52; slider57 = 58; slider58 = 60;
  ) : idx == 3 ? ( // 04: Raw 4-Track (DS-1 + Solid-State Combo + WAV IR)
    slider1 = 0.0; slider2 = 135; slider3 = -50; slider4 = 1;
    slider10 = 1; slider11 = 1; slider29 = 8.5; slider37 = 7.0; slider38 = 8.2;
    slider65 = 1; slider76 = 0; slider66 = -2.5; slider67 = -2; slider68 = 0; slider69 = 3.5; slider70 = 2.5; slider71 = 4; slider72 = 4;   // Round 42: was the Input Pre-EQ
    slider20 = 0; slider77 = 4.5; slider78 = 4.0;   // CE-2
    slider40 = 0; slider41 = 0; slider42 = 1.5; slider43 = 10; slider44 = 70; slider45 = 0;
    slider49 = 1; slider51 = -0.5;
    slider54 = 2; slider55 = 42; slider56 = 60; slider57 = 68; slider58 = 70;
  ) : idx == 4 ? ( // 05: Swedish Chainsaw (HM-2 everything on 10 + Solid-State Amp + WAV IR)
    slider1 = 0.0; slider2 = 95; slider3 = -48; slider4 = 1;
    slider10 = 1; slider11 = 3; slider62 = 10.0; slider63 = 10.0; slider64 = 10.0; slider9 = 5.0;
    slider20 = 0; slider77 = 4.5; slider78 = 5.0;   // CE-2
    slider40 = 1; slider41 = 1; slider42 = 1.6; slider43 = 12; slider44 = 45; slider45 = 14;
    slider49 = 1; slider51 = -1.8;
    slider54 = 2; slider55 = 64; slider56 = 58; slider57 = 64; slider58 = 68;
  ) : idx == 5 ? ( // 06: Freezing Clean (Distortion bypassed + Tube Amp + CE-2 Chorus + Hall)
    slider1 = 3.5; slider2 = 75; slider3 = -62; slider4 = 1;
    slider10 = 0; slider11 = 0;
    slider20 = 1; slider77 = 4.8; slider78 = 6.8;   // CE-2
    slider40 = 1; slider41 = 0; slider42 = 4.2; slider43 = 25; slider44 = 42; slider45 = 34;
    slider49 = 1; slider51 = -1.0;
    slider54 = 1; slider55 = 52; slider56 = 50; slider57 = 64; slider58 = 62;
  ) : ( // 07: Ambient Swell (RAT + Tube Amp + CE-2 + 7.8s Ambient Reverb)
    slider1 = 0.0; slider2 = 100; slider3 = -54; slider4 = 1;
    slider10 = 1; slider11 = 0; slider26 = 6.5; slider27 = 4.0; slider28 = 7.5;
    slider65 = 1; slider76 = 0; slider66 = -0.5; slider67 = -0.5; slider68 = 0.5; slider69 = 2; slider70 = 1; slider71 = 1; slider72 = 1;   // Round 42: was the Input Pre-EQ
    slider20 = 1; slider77 = 4.0; slider78 = 6.4;   // CE-2
    slider40 = 1; slider41 = 2; slider42 = 7.8; slider43 = 40; slider44 = 55; slider45 = 46;
    slider49 = 1; slider51 = -1.0;
    slider54 = 1; slider55 = 50; slider56 = 54; slider57 = 58; slider58 = 60;
  );
  ui_need_sync = 1;
);
