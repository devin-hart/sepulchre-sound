// sepulchre_presets.jsfx-inc
// Global template recalls and per-module 3-preset quick toggles
@init

function sync_all_DSP() (
  update_core_coeffs();
  update_fx_coeffs();
  sliderchange(-1);
);

// Module 1: Distortion local presets (0, 1, 2)
function recall_dirt_preset(idx) (
  dirt_preset_idx = idx;
  idx == 0 ? ( // P1: RAT Crunch
    slider10 = 1; slider11 = 0; slider12 = 74;
    slider13 = 45; slider14 = 68; slider15 = 62;
    slider16 = 18; slider17 = 0.0;
  ) : idx == 1 ? ( // P2: Tight High-Gain
    slider10 = 1; slider11 = 1; slider12 = 82;
    slider13 = 56; slider14 = 38; slider15 = 76;
    slider16 = 10; slider17 = 1.0;
  ) : ( // P3: HM-2 Grind
    slider10 = 1; slider11 = 2; slider12 = 86;
    slider13 = 74; slider14 = 84; slider15 = 68;
    slider16 = 20; slider17 = -1.0;
  );
  sync_all_DSP();
);

// Module 2: Chorus local presets (0, 1, 2)
function recall_frost_preset(idx) (
  frost_preset_idx = idx;
  idx == 0 ? ( // P1: Subtle BBD
    slider20 = 1; slider21 = 0; slider22 = 0.45;
    slider23 = 52; slider24 = 48; slider25 = 34;
  ) : idx == 1 ? ( // P2: Wide Dimension
    slider20 = 1; slider21 = 1; slider22 = 0.80;
    slider23 = 65; slider24 = 68; slider25 = 42;
  ) : ( // P3: Fast Mod
    slider20 = 1; slider21 = 0; slider22 = 2.40;
    slider23 = 70; slider24 = 36; slider25 = 46;
  );
  sync_all_DSP();
);

// Module 3: Delay local presets (0, 1, 2)
function recall_echo_preset(idx) (
  echo_preset_idx = idx;
  idx == 0 ? ( // P1: Slapback
    slider30 = 1; slider31 = 0; slider32 = 165;
    slider33 = 25; slider34 = 42; slider35 = 24; slider36 = 0;
  ) : idx == 1 ? ( // P2: Tape Lead
    slider30 = 1; slider31 = 0; slider32 = 420;
    slider33 = 48; slider34 = 36; slider35 = 32; slider36 = 0;
  ) : ( // P3: Long Echo
    slider30 = 1; slider31 = 1; slider32 = 560;
    slider33 = 58; slider34 = 52; slider35 = 36; slider36 = 0;
  );
  sync_all_DSP();
);

// Module 4: Reverb local presets (0, 1, 2)
function recall_cavern_preset(idx) (
  cavern_preset_idx = idx;
  idx == 0 ? ( // P1: Room / Hall
    slider40 = 1; slider41 = 0; slider42 = 2.6;
    slider43 = 20; slider44 = 60; slider45 = 22;
  ) : idx == 1 ? ( // P2: Bright Plate
    slider40 = 1; slider41 = 1; slider42 = 1.9;
    slider43 = 10; slider44 = 30; slider45 = 28;
  ) : ( // P3: Ambient Wash
    slider40 = 1; slider41 = 2; slider42 = 6.5;
    slider43 = 35; slider44 = 65; slider45 = 38;
  );
  sync_all_DSP();
);

// Global Presets:
// 0 = Tight Rhythm (Modern High-Gain drive, high pick attack, subtle Hall reverb, no chorus/delay)
// 1 = Cold Lead (RAT distortion, slow Analog BBD chorus, Tape delay, Plate reverb)
// 2 = Doom Wall (HM-2 distortion -> Dimension chorus -> Tape delay -> Ambient reverb, playable & articulate)
function recall_global_preset(idx) (
  slider60 = idx;
  idx == 0 ? ( // Tight Rhythm
    slider1 = 2.5; slider2 = 120; slider3 = -48; slider4 = 1;
    // Standard order: Distortion(0) -> Chorus(1) -> Delay(2) -> Reverb(3)
    slider5 = 0; slider6 = 1; slider7 = 2; slider8 = 3;
    // Distortion: Modern High-Gain
    slider10 = 1; slider11 = 1; slider12 = 84;
    slider13 = 52; slider14 = 36; slider15 = 78;
    slider16 = 12; slider17 = 1.0;
    // Chorus: Off
    slider20 = 0; slider21 = 0; slider22 = 0.6;
    slider23 = 45; slider24 = 55; slider25 = 0;
    // Delay: Off
    slider30 = 0; slider31 = 1; slider32 = 340;
    slider33 = 30; slider34 = 60; slider35 = 18; slider36 = 0;
    // Reverb: Subtle Hall
    slider40 = 1; slider41 = 0; slider42 = 2.2;
    slider43 = 18; slider44 = 64; slider45 = 16;
    // Cab: 4x12 V30
    slider49 = 1; slider50 = 0; slider51 = 0.0;
    dirt_preset_idx = 1; cavern_preset_idx = 0;
  ) : idx == 1 ? ( // Cold Lead
    slider1 = 1.0; slider2 = 105; slider3 = -52; slider4 = 1;
    // Standard order: Distortion(0) -> Chorus(1) -> Delay(2) -> Reverb(3)
    slider5 = 0; slider6 = 1; slider7 = 2; slider8 = 3;
    // Distortion: RAT
    slider10 = 1; slider11 = 0; slider12 = 76;
    slider13 = 42; slider14 = 70; slider15 = 64;
    slider16 = 18; slider17 = 0.0;
    // Chorus: Slow Analog BBD
    slider20 = 1; slider21 = 0; slider22 = 0.38;
    slider23 = 58; slider24 = 46; slider25 = 38;
    // Delay: Tape Delay
    slider30 = 1; slider31 = 0; slider32 = 390;
    slider33 = 44; slider34 = 38; slider35 = 28; slider36 = 0;
    // Reverb: Plate
    slider40 = 1; slider41 = 1; slider42 = 3.0;
    slider43 = 24; slider44 = 48; slider45 = 24;
    // Cab: 2x12 Combo
    slider49 = 1; slider50 = 1; slider51 = 0.0;
    dirt_preset_idx = 0; frost_preset_idx = 0; echo_preset_idx = 1; cavern_preset_idx = 1;
  ) : ( // Doom Wall
    slider1 = 2.0; slider2 = 85; slider3 = -52; slider4 = 1;
    // Standard playable order: Distortion(0) -> Chorus(1) -> Delay(2) -> Reverb(3)
    slider5 = 0; slider6 = 1; slider7 = 2; slider8 = 3;
    // Distortion: HM-2
    slider10 = 1; slider11 = 2; slider12 = 86;
    slider13 = 74; slider14 = 84; slider15 = 68;
    slider16 = 20; slider17 = -0.5;
    // Chorus: Dimension subtle widening
    slider20 = 1; slider21 = 1; slider22 = 0.35;
    slider23 = 55; slider24 = 52; slider25 = 30;
    // Delay: Controlled atmospheric repeats (52% feedback, no runaway self-oscillation)
    slider30 = 1; slider31 = 0; slider32 = 520;
    slider33 = 52; slider34 = 38; slider35 = 30; slider36 = 0;
    // Reverb: Ambient wash (35% mix so notes stay articulate)
    slider40 = 1; slider41 = 2; slider42 = 6.2;
    slider43 = 32; slider44 = 62; slider45 = 35;
    // Cab: Damped 4x12
    slider49 = 1; slider50 = 2; slider51 = 0.0;
    dirt_preset_idx = 2; frost_preset_idx = 1; echo_preset_idx = 2; cavern_preset_idx = 2;
  );
  sync_all_DSP();
);
